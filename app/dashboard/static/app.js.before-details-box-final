document.addEventListener("click", function (event) {

    /* ---------- VIEW DETAILS ---------- */

    const detailsButton =
        event.target.closest("#incidents button");

    if (
        detailsButton &&
        detailsButton.textContent.includes("VIEW DETAILS")
    ) {

        event.preventDefault();
        event.stopPropagation();

        console.log("🔎 VIEW DETAILS BUTTON CLICKED");

        const card =
            detailsButton.closest("div[style*='border-left']");

        if (!card) {
            console.error("❌ Incident card not found");
            return;
        }

        const buttons =
            document.querySelectorAll(
                "#incidents button"
            );

        const allCards =
            document.querySelectorAll(
                "#incidents > div"
            );

        let incidentId = null;

        /*
         * Find incident ID from the button's
         * existing onclick attribute.
         */

        const onclick =
            detailsButton.getAttribute("onclick");

        if (onclick) {

            const match =
                onclick.match(
                    /viewDetailsById\(['"]([^'"]+)['"]\)/
                );

            if (match) {
                incidentId = match[1];
            }

        }

        if (!incidentId) {

            console.error(
                "❌ Incident ID could not be detected"
            );

            return;
        }

        console.log(
            "🔎 Incident ID:",
            incidentId
        );

        if (
            typeof window.viewDetailsById ===
            "function"
        ) {

            window.viewDetailsById(
                incidentId
            );

        } else if (
            typeof viewDetailsById ===
            "function"
        ) {

            viewDetailsById(
                incidentId
            );

        } else {

            console.error(
                "❌ viewDetailsById function not available"
            );

        }

        return;
    }


    /* ---------- REFRESH INCIDENTS ---------- */

    const refreshButton =
        event.target.closest(
            "#refreshIncidentsBtn"
        );

    if (refreshButton) {

        event.preventDefault();
        event.stopPropagation();

        console.log(
            "🔄 REFRESH INCIDENTS BUTTON CLICKED"
        );

        if (
            typeof window.loadIncidents ===
            "function"
        ) {

            window.loadIncidents();

        } else if (
            typeof loadIncidents ===
            "function"
        ) {

            loadIncidents();

        } else {

            console.error(
                "❌ loadIncidents function not available"
            );

        }

    }

});

