    color:#4ade80;
    border:1px solid rgba(34,197,94,.25);
    padding:6px 10px;
    border-radius:999px;
    font-size:10px;
    font-weight:900;
}


/* ---------- MONITOR ITEMS ---------- */

.monitor-status-list{
    display:grid;
    gap:12px;
}

.monitor-status-item{
    display:flex;
    align-items:center;
    gap:12px;
    background:#0b1322;
    border:1px solid #1d2a3d;
    border-radius:11px;
    padding:13px;
}

.monitor-status-item strong{
    display:block;
    font-size:13px;
}

.monitor-status-item small{
    display:block;
    color:#64748b;
    margin-top:3px;
    font-size:11px;
}

.status-dot{
    width:9px;
    height:9px;
    border-radius:50%;
    flex-shrink:0;
}

.status-dot.online{
    background:#22c55e;
    box-shadow:0 0 10px rgba(34,197,94,.7);
}

.status-dot.folder{
    background:#60a5fa;
    box-shadow:0 0 10px rgba(96,165,250,.5);
}


/* ---------- PROTECTION ---------- */

.protection-status{
    display:flex;
    align-items:center;
    gap:15px;
    padding:18px;
    background:#0b1322;
    border:1px solid #1d2a3d;
    border-radius:12px;
}

.protection-icon{
    width:52px;
    height:52px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:14px;
    background:rgba(37,99,235,.12);
    font-size:25px;
}

.protection-status strong{
    display:block;
    font-size:14px;
}

.protection-status small{
    display:block;
    color:#64748b;
    margin-top:5px;
    font-size:11px;
}

.protection-footer{
    display:flex;
    justify-content:space-between;
    margin-top:15px;
    padding-top:14px;
    border-top:1px solid #1d2a3d;
    font-size:10px;
    letter-spacing:1px;
    color:#64748b;
}

.protection-footer strong{
    color:#4ade80;
}


/* =========================================================
   SCANNER
========================================================= */

.scanner{
    background:
        linear-gradient(145deg,#101a2b,#0c1524);
    border:1px solid #263449;
    border-radius:16px;
    box-shadow:0 8px 25px rgba(0,0,0,.22);
}

.scanner h2{
    font-size:19px;
}

.scanner p{
    color:#64748b;
}

input[type="file"]{
    background:#0b1322;
    border:1px dashed #334155;
    cursor:pointer;
}

input[type="file"]:hover{
    border-color:#3b82f6;
}


/* ---------- BUTTONS ---------- */

button{
    border-radius:9px;
    transition:.2s ease;
}

button:hover{
    transform:translateY(-1px);
    opacity:1;
}

#scanButton{
    background:linear-gradient(135deg,#2563eb,#1d4ed8);
    box-shadow:0 5px 15px rgba(37,99,235,.22);
}

#refreshIncidentsBtn{
    background:#172235;
    border:1px solid #334155;
}

#refreshIncidentsBtn:hover{
    border-color:#3b82f6;
}


/* =========================================================
   THREAT ANALYTICS
========================================================= */

.phase11-chart-grid{
    display:grid !important;
    grid-template-columns:1fr 1fr !important;
    gap:18px !important;
    margin:22px 0 !important;
}

.phase11-chart-card{
    background:
        linear-gradient(145deg,#101a2b,#0b1423) !important;
    border:1px solid #263449 !important;
    border-radius:16px !important;
    padding:22px !important;
    min-height:470px;
    box-shadow:0 8px 25px rgba(0,0,0,.22);
}

.phase11-chart-card h2{
    font-size:18px;
    margin-bottom:5px;
}


/* ---------- DONUT ---------- */

.risk-distribution-donut{
    width:235px !important;
    height:235px !important;
    margin:25px auto !important;
    box-shadow:
        0 0 35px rgba(0,0,0,.35),
        0 0 45px rgba(59,130,246,.06) !important;
}

.risk-donut-center{
    background:#080f1c !important;
    border:1px solid #263449;
}


/* ---------- ANALYTICS LEGEND ---------- */

.risk-legend{
    gap:10px !important;
}

.risk-legend-item{
    background:#0b1322 !important;
    border:1px solid #1d2a3d !important;
    border-radius:10px !important;
    padding:11px 12px !important;
    transition:.2s ease;
}

.risk-legend-item:hover{
    border-color:#334155 !important;
    transform:translateY(-1px);
}

.risk-legend-item strong{
    font-size:15px !important;
}


/* =========================================================
   OVERALL SECURITY CIRCLE
========================================================= */

#overallSecuritySection{
    min-height:470px !important;
}

#overallCircle{
    width:250px !important;
    height:250px !important;
    box-shadow:
        0 0 35px rgba(0,0,0,.45),
        0 0 70px rgba(59,130,246,.08) !important;
}

#overallCircle > div{
    width:165px !important;
    height:165px !important;
    background:#080f1c !important;
    border:1px solid #263449;
}

#overallTotal{
    font-size:42px !important;
}


/* =========================================================
   RECENT INCIDENTS
========================================================= */

#incidents{
    display:grid;
    gap:12px;
}

#incidents > div{
    border-radius:13px !important;
}

.incident{
    color:#cbd5e1;
}


/* =========================================================
   SEARCH / FILTER BAR
========================================================= */

#incidentSearch{
    background:#0b1322 !important;
    border:1px solid #263449 !important;
}

#incidentSearch:focus{
    outline:none;
    border-color:#3b82f6 !important;
    box-shadow:0 0 0 3px rgba(59,130,246,.08);
}

#riskFilter,
#statusFilter{
    background:#0b1322 !important;
    border:1px solid #263449 !important;
    min-width:150px;
}

#riskFilter:focus,
#statusFilter:focus{
    outline:none;
    border-color:#3b82f6;
}


/* =========================================================
   FOOTER
========================================================= */

footer{
    border-top:1px solid #172235;
    background:#070d18;
    margin-top:20px;
}


/* =========================================================
   MOBILE
========================================================= */

@media(max-width:1000px){

    .top-cards{
        grid-template-columns:repeat(2,1fr);
    }

    .phase11-monitor-grid{
        grid-template-columns:1fr;
    }

    .phase11-chart-grid{
        grid-template-columns:1fr !important;
    }
}


@media(max-width:600px){

    .container{
        padding:18px 14px 35px;
    }

    header{
        padding:20px 18px;
    }

    header h1{
        font-size:21px;
    }

    .top-cards{
        grid-template-columns:1fr 1fr;
        gap:10px;
    }

    .top-cards .stat-card{
        padding:16px;
        min-height:105px;
    }

    .top-cards .stat-value{
        font-size:27px;
    }

    .phase11-chart-card{
        padding:16px !important;
        min-height:auto;
    }

    #overallCircle{
        width:210px !important;
        height:210px !important;
    }

    #overallCircle > div{
        width:140px !important;
        height:140px !important;
    }

    #overallTotal{
        font-size:34px !important;
    }
}


