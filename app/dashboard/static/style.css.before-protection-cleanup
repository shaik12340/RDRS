/* ==========================================
   SECURITY ANALYTICS
========================================== */

.security-analytics-panel {
    padding-bottom: 22px;
}

.analytics-chart-container {
    width: 100%;
    height: 360px;
    position: relative;
    padding: 10px 5px 0;
}

.analytics-chart {
    position: relative;
    width: 100%;
    height: 100%;
}

.analytics-chart canvas {
    width: 100% !important;
    height: 100% !important;
}

.analytics-summary {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-top: 18px;
}

.analytics-item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #111827;
    border: 1px solid #1e293b;
    border-radius: 10px;
    padding: 12px;
    color: #94a3b8;
    font-size: 11px;
    font-weight: 700;
}

.analytics-item strong {
    color: #f8fafc;
    margin-left: 4px;
}

.analytics-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
}

.critical-dot {
    background: #ef4444;
}

.high-dot {
    background: #f97316;
}

.medium-dot {
    background: #eab308;
}

.low-dot {
    background: #22c55e;
}


@media (max-width: 700px) {

    .protection-grid {
        grid-template-columns: 1fr;
    }

    .analytics-summary {
        grid-template-columns: repeat(2, 1fr);
    }

    .analytics-chart-container {
        height: 300px;
    }

}



