    display: block;
    color: #f8fafc;
    font-size: 14px;
}

.monitor-status-item small {
    display: block;
    color: #64748b;
    margin-top: 4px;
    font-size: 12px;
}

.status-dot {
    width: 10px;
    height: 10px;
    min-width: 10px;
    border-radius: 50%;
}

.status-dot.online {
    background: #22c55e;
    box-shadow: 0 0 10px rgba(34,197,94,.7);
}

.status-dot.folder {
    background: #38bdf8;
    box-shadow: 0 0 10px rgba(56,189,248,.6);
}

.protection-status {
    display: flex;
    align-items: center;
    gap: 15px;
    background: #111827;
    border: 1px solid #1f2937;
    border-radius: 12px;
    padding: 18px;
}

.protection-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #172554;
    border-radius: 12px;
    font-size: 24px;
}

.protection-status strong {
    display: block;
    color: #f8fafc;
    font-size: 14px;
}

.protection-status small {
    display: block;
    color: #64748b;
    margin-top: 5px;
    line-height: 1.4;
    font-size: 12px;
}

.protection-footer {
    display: flex;
    justify-content: space-between;
    margin-top: 18px;
    padding-top: 15px;
    border-top: 1px solid #1e293b;
    font-size: 11px;
    letter-spacing: 1px;
}

.protection-footer span {
    color: #64748b;
}

.protection-footer strong {
    color: #22c55e;
}

@media (max-width: 850px) {
    .phase11-monitor-grid {
        grid-template-columns: 1fr;
    }
}



/* =====================================================
   PHASE 11 — PROFESSIONAL CHART SECTION
===================================================== */



/* =========================================================
   RDRS PHASE 11 — FINAL PROFESSIONAL DASHBOARD UI
   ========================================================= */

.phase11-analytics {
    width: 100%;
    margin: 30px 0;
}

.phase11-analytics-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
}

.phase11-analytics-header h2 {
    margin: 4px 0 0;
    font-size: 22px;
    color: #f8fafc;
}

.phase11-analytics-header small {
    color: #64748b;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.5px;
}

.phase11-chart-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    width: 100%;
}

.phase11-chart-card {
    position: relative;
    background:
        linear-gradient(
            145deg,
            rgba(30, 41, 59, 0.98),
            rgba(15, 23, 42, 0.98)
        );
    border: 1px solid rgba(148, 163, 184, 0.12);
    border-radius: 16px;
    padding: 22px;
    min-height: 410px;
    overflow: hidden;
    box-shadow:
        0 18px 45px rgba(0, 0, 0, 0.20),
        inset 0 1px 0 rgba(255,255,255,0.025);
}

.phase11-chart-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(
        90deg,
        transparent,
        rgba(59,130,246,.75),
        transparent
    );
}

.phase11-chart-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 18px;
}

.phase11-panel-label {
    display: block;
    color: #64748b;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 1.7px;
    text-transform: uppercase;
}

.phase11-chart-header h2 {
    margin: 5px 0 0;
    font-size: 19px;
    color: #f8fafc;
}

.phase11-live-badge {
    padding: 6px 10px;
    border-radius: 999px;
    background: rgba(34,197,94,.10);
    border: 1px solid rgba(34,197,94,.22);
    color: #4ade80;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: .8px;
}

.risk-donut-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 235px;
}

.risk-distribution-donut {
    width: 215px;
    height: 215px;
    border-radius: 50%;
    position: relative;

    background:
        conic-gradient(
            #ef4444 0deg,
            #f97316 90deg,
            #eab308 180deg,
            #22c55e 270deg,
            #334155 270deg
        );

    display: flex;
    align-items: center;
    justify-content: center;

    box-shadow:
        0 0 35px rgba(59,130,246,.08),
        0 15px 40px rgba(0,0,0,.28);
}

.risk-distribution-donut::before {
    content: "";
    position: absolute;
    inset: 18px;
    border-radius: 50%;
    background: #0f172a;
    box-shadow: inset 0 0 25px rgba(0,0,0,.45);
}

.risk-donut-center {
    position: relative;
    z-index: 2;

    width: 120px;
    height: 120px;
    border-radius: 50%;

    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.risk-donut-center strong {
    font-size: 42px;
    line-height: 1;
    color: #f8fafc;
    font-weight: 900;
}

.risk-donut-center span {
    margin-top: 8px;
    color: #64748b;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 1.2px;
}

.risk-legend {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    margin-top: 8px;
}

.risk-legend-item {
    display: flex;
    align-items: center;
    gap: 7px;
    min-width: 0;
    padding: 10px 8px;

    background: rgba(15,23,42,.72);
    border: 1px solid rgba(148,163,184,.08);
    border-radius: 9px;

    color: #94a3b8;
    font-size: 10px;
    font-weight: 800;
}

.risk-legend-item strong {
    margin-left: auto;
    color: #f8fafc;
    font-size: 13px;
}

.risk-dot {
    width: 8px;
    height: 8px;
    min-width: 8px;
    border-radius: 50%;
}

.critical-dot {
    background: #ef4444;
    box-shadow: 0 0 8px rgba(239,68,68,.55);
}

.high-dot {
    background: #f97316;
    box-shadow: 0 0 8px rgba(249,115,22,.45);
}

.medium-dot {
    background: #eab308;
    box-shadow: 0 0 8px rgba(234,179,8,.45);
}

.low-dot {
    background: #22c55e;
    box-shadow: 0 0 8px rgba(34,197,94,.45);
}


/* =========================================================
   OVERALL SECURITY STATUS
   ========================================================= */

#overallSecuritySection {
    min-height: 410px;
}

#overallSecuritySection > h2,
#overallSecuritySection > p {
    display: none;
}

#overallCircle {
    margin: 18px auto 15px !important;

    width: 215px !important;
    height: 215px !important;

    border-radius: 50%;

    background:
        conic-gradient(
            #22c55e,
            #22c55e 25%,
            #334155 25%,
            #334155 100%
        ) !important;

    box-shadow:
        0 0 35px rgba(34,197,94,.12),
        0 15px 40px rgba(0,0,0,.30) !important;
}

#overallCircle::after {
    content: "MONITORING";
    position: absolute;

    bottom: 27px;

    color: #4ade80;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 1.5px;
}

#overallCircle > div {
    width: 145px !important;
    height: 145px !important;

    background: #0f172a !important;

    border: 1px solid rgba(148,163,184,.10);

    box-shadow:
        inset 0 0 25px rgba(0,0,0,.5) !important;
}

#overallTotal {
    font-size: 42px !important;
    font-weight: 900 !important;
}


/* =========================================================
   TOP DASHBOARD CARDS
   ========================================================= */

.top-cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 24px;
}

.top-cards .stat-card {
    position: relative;
    background:
        linear-gradient(
            145deg,
            rgba(30,41,59,.96),
            rgba(15,23,42,.96)
        );
    border: 1px solid rgba(148,163,184,.10);
    border-radius: 14px;
    padding: 20px;
    min-height: 105px;
    box-shadow: 0 12px 30px rgba(0,0,0,.18);
}

.top-cards .stat-title {
    color: #64748b;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 1.2px;
}

.top-cards .stat-value {
    margin-top: 8px;
    font-size: 30px;
    font-weight: 900;
    color: #f8fafc;
}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1000px) {

    .phase11-chart-grid {
        grid-template-columns: 1fr;
    }

    .top-cards {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 600px) {

    .top-cards {
        grid-template-columns: 1fr;
    }

    .phase11-chart-card {
        padding: 16px;
        min-height: auto;
    }

    .risk-distribution-donut,
    #overallCircle {
        width: 190px !important;
        height: 190px !important;
    }

    #overallCircle > div {
        width: 125px !important;
        height: 125px !important;
    }

    .risk-legend {
        grid-template-columns: repeat(2, 1fr);
    }
}

