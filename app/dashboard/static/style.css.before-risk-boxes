/* ==========================================
   RDRS LIVE PROTECTION CARDS
========================================== */

.protection-card {
    position: relative;
    min-height: 150px;
    text-align: left;
    padding: 22px;
    overflow: hidden;
}

.protection-card::after {
    content: "";
