*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial;
}

body{
display:flex;
background:#020617;
color:white;
}

.sidebar{
width:220px;
height:100vh;
background:#0f172a;
padding:25px;
border-right:1px solid #1e293b;
}

.sidebar h2{
color:#60a5fa;
margin-bottom:30px;
}

.sidebar ul{
list-style:none;
}

.sidebar li{
padding:14px;
margin:10px 0;
border-radius:8px;
cursor:pointer;
}

.sidebar li.active,
.sidebar li:hover{
background:#2563eb;
}

.main{
flex:1;
padding:30px;
}

.topbar{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:25px;
}

.online{
color:#22c55e;
font-weight:bold;
}

.cards{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:20px;
margin-bottom:30px;
}

.card{
padding:20px;
border-radius:14px;
box-shadow:0 8px 20px rgba(0,0,0,.4);
}

.blue{background:#2563eb;}
.purple{background:#7c3aed;}
.orange{background:#ea580c;}
.green{background:#15803d;}

.card p{
opacity:.8;
margin-bottom:8px;
}

.card h2{
font-size:32px;
}

.tablebox{
background:#111827;
padding:20px;
border-radius:14px;
}

table{
width:100%;
border-collapse:collapse;
margin-top:15px;
}

th,td{
padding:12px;
border-bottom:1px solid #374151;
text-align:left;
}

th{
color:#93c5fd;
}

/* =========================================================
   RDRS INCIDENT DETAILS MODAL - CLEAN FINAL VERSION
   ========================================================= */

/* Overlay */
#detailsModal {
    position: fixed !important;
    inset: 0 !important;

    width: 100vw !important;
    height: 100vh !important;

    display: none !important;

    align-items: center !important;
    justify-content: center !important;

    padding: 20px !important;

    background: rgba(0, 0, 0, 0.78) !important;

    overflow: hidden !important;

    z-index: 999999 !important;

    box-sizing: border-box !important;
}

/* JS opens modal */
#detailsModal[style*="display: flex"] {
    display: flex !important;
}

/* Modal box */
#detailsModal .details-modal-box {
    position: relative !important;

    width: min(760px, calc(100vw - 40px)) !important;
    max-width: calc(100vw - 40px) !important;

    height: auto !important;
    max-height: calc(100vh - 40px) !important;

    min-width: 0 !important;
    min-height: 0 !important;

    margin: 0 !important;
    padding: 28px !important;

    background: #111827 !important;
    color: #f8fafc !important;

    border: 1px solid #334155 !important;
    border-radius: 16px !important;

    box-sizing: border-box !important;

    overflow-x: hidden !important;
    overflow-y: auto !important;

    overscroll-behavior: contain !important;

    box-shadow:
        0 25px 60px rgba(0,0,0,.65) !important;
}

/* Modal heading */
#detailsModal .details-modal-box h2 {
    width: 100% !important;

    margin: 0 0 18px 0 !important;
    padding: 0 45px 12px 0 !important;

    color: #ffffff !important;

    border-bottom: 1px solid #334155 !important;

    box-sizing: border-box !important;

    overflow-wrap: anywhere !important;
    word-break: break-word !important;
}

/* Details content */
#detailsModal #detailsContent {
    display: flex !important;

    flex-direction: column !important;

    width: 100% !important;
    max-width: 100% !important;

    min-width: 0 !important;

    gap: 12px !important;

    box-sizing: border-box !important;

    overflow: visible !important;
}

/* Individual detail box */
#detailsModal #detailsContent .detail-box {
    display: block !important;

    width: 100% !important;
    max-width: 100% !important;

    min-width: 0 !important;
    height: auto !important;

    margin: 0 !important;
    padding: 13px 15px !important;

    background: #0f172a !important;

    border: 1px solid #334155 !important;
    border-radius: 9px !important;

    box-sizing: border-box !important;

    overflow: hidden !important;
}

/* Labels */
#detailsModal #detailsContent .detail-box > strong {
    display: block !important;

    width: 100% !important;
    max-width: 100% !important;

    margin: 0 0 6px 0 !important;

    color: #94a3b8 !important;

    font-size: 13px !important;
    font-weight: 700 !important;

    box-sizing: border-box !important;

    overflow-wrap: anywhere !important;
    word-break: break-word !important;
}

/* Values */
#detailsModal #detailsContent .detail-value {
    display: block !important;

    width: 100% !important;
    max-width: 100% !important;

    min-width: 0 !important;

    margin: 0 !important;
    padding: 0 !important;

    color: #ffffff !important;

    white-space: normal !important;

    word-break: break-all !important;
    overflow-wrap: anywhere !important;

    line-height: 1.55 !important;

    box-sizing: border-box !important;

    overflow: hidden !important;
}

/* SHA-256 */
#detailsModal #detailsContent .detail-value[style*="monospace"] {
    font-family: monospace !important;

    font-size: 11px !important;

    line-height: 1.6 !important;

    letter-spacing: 0 !important;

    white-space: normal !important;

    word-break: break-all !important;

    overflow-wrap: anywhere !important;
}

/* Risk reasons */
#detailsModal #detailsContent ul {
    display: block !important;

    width: 100% !important;
    max-width: 100% !important;

    min-width: 0 !important;

    margin: 8px 0 0 0 !important;
    padding-left: 20px !important;

    box-sizing: border-box !important;

    overflow: hidden !important;
}

#detailsModal #detailsContent li {
    display: list-item !important;

    width: 100% !important;
    max-width: 100% !important;

    margin: 6px 0 !important;

    white-space: normal !important;

    word-break: break-word !important;
    overflow-wrap: anywhere !important;

    box-sizing: border-box !important;
}

/* Close button */
#detailsModal .details-close {
    position: absolute !important;

    top: 12px !important;
    right: 14px !important;

    width: 36px !important;
    height: 36px !important;

    padding: 0 !important;
    margin: 0 !important;

    border: none !important;
    border-radius: 8px !important;

    background: #1f2937 !important;

    color: #ffffff !important;

    font-size: 25px !important;
    line-height: 34px !important;

    text-align: center !important;

    cursor: pointer !important;

    z-index: 1000000 !important;
}

#detailsModal .details-close:hover {
    background: #374151 !important;
}

/* Prevent anything inside modal from creating horizontal overflow */
#detailsModal *,
#detailsModal *::before,
#detailsModal *::after {
    box-sizing: border-box !important;

    max-width: 100% !important;
}

/* Action buttons container */
#detailsModal #detailsContent > div:last-child {
    width: 100% !important;
    max-width: 100% !important;

    min-width: 0 !important;

    display: flex !important;

    flex-wrap: wrap !important;

    gap: 10px !important;

    box-sizing: border-box !important;
}

/* Mobile */
@media (max-width: 600px) {

    #detailsModal {
        padding: 8px !important;
    }

    #detailsModal .details-modal-box {
        width: 100% !important;
        max-width: 100% !important;

        max-height: calc(100vh - 16px) !important;

        padding: 22px 15px !important;

        border-radius: 12px !important;
    }

    #detailsModal #detailsContent .detail-box {
        padding: 12px !important;
    }

    #detailsModal #detailsContent .detail-value[style*="monospace"] {
        font-size: 10px !important;
    }
}

/* =========================================================
   MODAL SHOW STATE
   ========================================================= */

#detailsModal.show {
    display: flex !important;
}


/* =====================================================
   RDRS BUTTON + DETAILS MODAL CLICK FIX
   DO NOT MODIFY OTHER DASHBOARD COMPONENTS
===================================================== */

/* Hidden modal must NEVER block dashboard clicks */
#detailsModal {
    pointer-events: none !important;
}

/* Open modal can receive clicks */
#detailsModal.show,
#detailsModal[style*="display: flex"] {
    pointer-events: auto !important;
}

/* Dashboard buttons stay clickable */
#refreshIncidentsBtn,
.details-button {
    position: relative !important;
    z-index: 10 !important;
    pointer-events: auto !important;
    cursor: pointer !important;
}

/* Modal close button */
#detailsModal .details-close {
    pointer-events: auto !important;
    cursor: pointer !important;
}


/* =====================================================
   RDRS - INCIDENT BUTTON CLICK FIX ONLY
===================================================== */

#refreshIncidentsBtn {
    position: relative !important;
    z-index: 999999 !important;
    pointer-events: auto !important;
    cursor: pointer !important;
}

#incidents button {
    position: relative !important;
    z-index: 999999 !important;
    pointer-events: auto !important;
    cursor: pointer !important;
}

#detailsModal {
    pointer-events: none !important;
}

#detailsModal.show,
#detailsModal[style*="display: flex"] {
    pointer-events: auto !important;
}

#detailsModal .details-close {
    pointer-events: auto !important;
}


