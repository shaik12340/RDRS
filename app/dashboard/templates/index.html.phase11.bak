<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>RDRS Security Dashboard</title>
    <link rel="stylesheet" href="/dashboard/static/style.css">

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #0f172a;
            color: white;
        }

        header {
            background: #111827;
            padding: 20px 30px;
            border-bottom: 1px solid #374151;
        }

        header h1 {
            margin: 0;
        }

        header p {
            color: #94a3b8;
        }

        .container {
            padding: 25px;
            max-width: 1200px;
            margin: auto;
        }

        .scanner {
            background: #1e293b;
            padding: 25px;
            border-radius: 12px;
            margin-bottom: 25px;
        }

        .scanner h2 {
            margin-top: 0;
        }

        input[type="file"] {
            margin: 15px 0;
            padding: 10px;
            background: #334155;
            color: white;
            border-radius: 6px;
            width: 100%;
        }

        button {
            background: #2563eb;
            color: white;
            border: none;
            padding: 10px 16px;
            border-radius: 7px;
            cursor: pointer;
            font-weight: bold;
            margin: 4px;
        }

        button:hover {
            opacity: 0.9;
        }

        button:disabled {
            background: #475569;
            cursor: not-allowed;
        }

        .details-btn {
            background: #7c3aed;
        }

        .quarantine {
            color: #ef4444;
            font-weight: bold;
        }

        #selectedFiles {
            color: #cbd5e1;
            margin: 10px 0;
        }

        .result {
            background: #1e293b;
            padding: 20px;
            border-radius: 12px;
            margin-top: 15px;
            border-left: 4px solid #334155;
        }

        .result h3 {
            margin-top: 0;
        }

        .LOW {
            color: #22c55e;
            font-weight: bold;
        }

        .MEDIUM {
            color: #eab308;
            font-weight: bold;
        }

        .HIGH {
            color: #fb923c;
            font-weight: bold;
        }

        .CRITICAL {
            color: #ef4444;
            font-weight: bold;
        }

        .hash {
            font-family: monospace;
            font-size: 12px;
            word-break: break-all;
            background: #0f172a;
            padding: 10px;
            border-radius: 6px;
        }

        .reason {
            margin: 6px 0;
            color: #fbbf24;
        }

        .success {
            color: #22c55e;
        }

        .error {
            color: #ef4444;
        }

        .info {
            color: #38bdf8;
        }

        .incident {
            color: #cbd5e1;
            font-family: monospace;
            font-size: 13px;
        }

        footer {
            text-align: center;
            padding: 25px;
            color: #64748b;
        }

        /* MODAL */

        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.75);
            overflow: auto;
        }

        .modal-content {
            background: #1e293b;
            margin: 5% auto;
            padding: 25px;
            width: 90%;
            max-width: 800px;
            border-radius: 12px;
            border: 1px solid #475569;
        }

        .close {
            float: right;
            font-size: 28px;
            cursor: pointer;
            color: #94a3b8;
        }

        .close:hover {
            color: white;
        }

        .detail-row {
            padding: 10px 0;
            border-bottom: 1px solid #374151;
        }

        .detail-label {
            color: #94a3b8;
            font-weight: bold;
        }

        .history {
            background: #0f172a;
            padding: 12px;
            border-radius: 8px;
            margin-top: 10px;
        }

        @media (max-width: 700px) {

            .container {
                padding: 15px;
            }

            .modal-content {
                width: 95%;
                margin: 10% auto;
            }

        }

    
<style>

/* ==========================================
   PROFESSIONAL INCIDENT CARDS
========================================== */

.incident-card {
    background: linear-gradient(
        145deg,
        #111827,
        #0f172a
    );

    border: 1px solid #374151;
    border-radius: 16px;

    margin: 18px 0;
    padding: 20px;

    box-shadow:
        0 8px 24px rgba(0,0,0,.30);

    transition:
        transform .2s ease,
        box-shadow .2s ease,
        border-color .2s ease;
}

.incident-card:hover {
    transform: translateY(-2px);

    border-color: #4b5563;

    box-shadow:
        0 12px 30px rgba(0,0,0,.40);
}


.incident-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;

    gap: 15px;

    padding-bottom: 15px;

    border-bottom: 1px solid #374151;
}


.incident-label {
    font-size: 10px;
    font-weight: bold;

    letter-spacing: 1.5px;

    color: #9ca3af;

    margin-bottom: 5px;
}


.incident-card h3 {
    margin: 0;

    color: #f9fafb;

    font-size: 17px;
}


.incident-badges {
    display: flex;
    gap: 8px;

    flex-wrap: wrap;
}


.risk-badge,
.status-badge {
    padding: 6px 11px;

    border-radius: 999px;

    font-size: 11px;

    font-weight: bold;

    letter-spacing: .5px;
}


/* Risk */

.risk-badge.critical {
    background: rgba(239,68,68,.15);
    color: #ef4444;
    border: 1px solid #ef4444;
}

.risk-badge.high {
    background: rgba(249,115,22,.15);
    color: #f97316;
    border: 1px solid #f97316;
}

.risk-badge.medium {
    background: rgba(234,179,8,.15);
    color: #eab308;
    border: 1px solid #eab308;
}

.risk-badge.low {
    background: rgba(34,197,94,.15);
    color: #22c55e;
    border: 1px solid #22c55e;
}


/* Status */

.status-badge.open {
    background: rgba(59,130,246,.15);
    color: #60a5fa;
    border: 1px solid #3b82f6;
}

.status-badge.contained {
    background: rgba(168,85,247,.15);
    color: #c084fc;
    border: 1px solid #a855f7;
}


/* Main */

.incident-main {
    padding: 18px 0;
}


.incident-info {
    display: grid;

    grid-template-columns:
        repeat(
            auto-fit,
            minmax(180px, 1fr)
        );

    gap: 12px;
}


.info-item {
    background: #0b1220;

    border: 1px solid #1f2937;

    border-radius: 10px;

    padding: 12px;
}


.info-label {
    display: block;

    color: #9ca3af;

    font-size: 10px;

    font-weight: bold;

    letter-spacing: 1px;

    margin-bottom: 6px;
}


.info-value {
    display: block;

    color: #e5e7eb;

    font-size: 13px;

    word-break: break-word;
}


.info-value.score {
    font-size: 20px;

    font-weight: bold;

    color: #f9fafb;
}


.incident-reasons {
    margin-top: 15px;

    background: #0b1220;

    border: 1px solid #1f2937;

    border-radius: 10px;

    padding: 14px;
}


.incident-reasons ul {
    margin: 8px 0 0 18px;

    color: #d1d5db;

    font-size: 13px;
}


.incident-reasons li {
    margin: 5px 0;
}


/* Footer */

.incident-footer {
    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 12px;

    padding-top: 15px;

    border-top: 1px solid #374151;
}


.incident-time {
    color: #9ca3af;

    font-size: 11px;

    word-break: break-all;
}


.details-button {
    background: #2563eb;

    color: white;

    border: none;

    padding: 9px 15px;

    border-radius: 8px;

    cursor: pointer;

    font-weight: bold;

    font-size: 12px;

    transition: .2s;
}


.details-button:hover {
    background: #1d4ed8;

    transform: translateY(-1px);
}


@media (max-width: 700px) {

    .incident-card-header {
        flex-direction: column;
    }

    .incident-footer {
        flex-direction: column;

        align-items: stretch;
    }

    .details-button {
        width: 100%;
    }

}



/* =========================================================
   RDRS PROFESSIONAL SIDEBAR
========================================================= */

body {
    padding-left: 250px !important;
    background:
        radial-gradient(
            circle at 80% 0%,
            rgba(37, 99, 235, 0.10),
            transparent 35%
        ),
        #020617 !important;
}

header {
    margin-left: -250px !important;
    padding-left: 280px !important;
    background: rgba(15, 23, 42, 0.94) !important;
    backdrop-filter: blur(12px);
    position: sticky;
    top: 0;
    z-index: 900;
}

.rdrs-sidebar {
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    width: 250px;
    z-index: 2000;
    background: #020617;
    border-right: 1px solid #1e293b;
    display: flex;
    flex-direction: column;
    box-shadow: 10px 0 35px rgba(0,0,0,0.25);
}

.rdrs-brand {
    height: 82px;
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    border-bottom: 1px solid #1e293b;
}

.rdrs-brand-icon {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    font-size: 21px;
    box-shadow: 0 8px 25px rgba(37,99,235,.25);
}

.rdrs-brand-text strong {
    display: block;
    color: white;
    font-size: 18px;
    letter-spacing: .5px;
}

.rdrs-brand-text span {
    color: #64748b;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1.2px;
}

.rdrs-nav {
    padding: 22px 12px;
    flex: 1;
}

.rdrs-nav-title {
    color: #475569;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 1.5px;
    padding: 0 12px 10px;
    text-transform: uppercase;
}

.rdrs-nav a {
    display: flex;
    align-items: center;
    gap: 13px;
    text-decoration: none;
    color: #94a3b8;
    padding: 12px 14px;
    margin: 4px 0;
    border-radius: 9px;
    font-size: 14px;
    transition: .2s ease;
}

.rdrs-nav a:hover {
    background: #0f172a;
    color: white;
    transform: translateX(2px);
}

.rdrs-nav a.active {
    background: linear-gradient(
        90deg,
        rgba(37,99,235,.20),
        rgba(37,99,235,.06)
    );
    color: #60a5fa;
    border-left: 3px solid #3b82f6;
}

.rdrs-nav-icon {
    width: 22px;
    text-align: center;
    font-size: 17px;
}

.rdrs-system {
    margin: 12px;
    padding: 15px;
    border-radius: 12px;
    background: #0f172a;
    border: 1px solid #1e293b;
}

.rdrs-system-title {
    color: #64748b;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 9px;
}

.rdrs-online {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #22c55e;
    font-size: 12px;
    font-weight: bold;
}

.rdrs-online-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 10px #22c55e;
}

.rdrs-user {
    padding: 15px;
    border-top: 1px solid #1e293b;
    display: flex;
    align-items: center;
    gap: 10px;
}

.rdrs-avatar {
    width: 35px;
    height: 35px;
    border-radius: 50%;
    background: #1e40af;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
}

.rdrs-user-info {
    flex: 1;
}

.rdrs-user-info strong {
    display: block;
    font-size: 13px;
    color: white;
}

.rdrs-user-info span {
    display: block;
    color: #64748b;
    font-size: 10px;
}

.rdrs-logout {
    border: none !important;
    background: transparent !important;
    color: #64748b !important;
    padding: 7px !important;
    margin: 0 !important;
    width: auto !important;
}

.rdrs-logout:hover {
    color: #ef4444 !important;
    background: #1f2937 !important;
}

.rdrs-pagebar {
    margin: 25px auto 0;
    max-width: 1200px;
    padding: 0 25px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.rdrs-page-title h2 {
    margin: 0;
    font-size: 24px;
    color: #f8fafc;
}

.rdrs-page-title p {
    margin: 5px 0 0;
    color: #64748b;
    font-size: 13px;
}

.rdrs-live {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 13px;
    border-radius: 20px;
    background: rgba(34,197,94,.08);
    border: 1px solid rgba(34,197,94,.2);
    color: #22c55e;
    font-size: 11px;
    font-weight: bold;
}

.rdrs-live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 9px #22c55e;
}

@media (max-width: 850px) {

    body {
        padding-left: 0 !important;
    }

    .rdrs-sidebar {
        width: 70px;
    }

    .rdrs-brand {
        justify-content: center;
        padding: 15px;
    }

    .rdrs-brand-text,
    .rdrs-nav-title,
    .rdrs-nav a span,
    .rdrs-system,
    .rdrs-user-info,
    .rdrs-logout {
        display: none !important;
    }

    .rdrs-nav a {
        justify-content: center;
        padding: 13px;
    }

    header {
        margin-left: 0 !important;
        padding-left: 20px !important;
    }
}


</style>

</style>


<style>
.soc-incidents {
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin-top: 20px;
}

.soc-card {
    background: #111827;
    border: 1px solid #374151;
    border-left: 6px solid #6b7280;
    border-radius: 12px;
    padding: 18px;
    box-shadow: 0 5px 15px rgba(0,0,0,.25);
}

.soc-card.critical { border-left-color: #ef4444; }
.soc-card.high { border-left-color: #f97316; }
.soc-card.medium { border-left-color: #eab308; }
.soc-card.low { border-left-color: #22c55e; }

.soc-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
}

.soc-id {
    font-weight: bold;
    font-size: 16px;
}

.soc-level {
    padding: 5px 10px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: bold;
}

.soc-level.critical {
    background: #7f1d1d;
    color: #fecaca;
}

.soc-level.high {
    background: #7c2d12;
    color: #fed7aa;
}

.soc-level.medium {
    background: #713f12;
    color: #fef08a;
}

.soc-level.low {
    background: #14532d;
    color: #bbf7d0;
}

.soc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit,minmax(180px,1fr));
    gap: 10px;
    margin-top: 15px;
}

.soc-item {
    background: #0b1220;
    padding: 10px;
    border-radius: 8px;
}

.soc-label {
    color: #9ca3af;
    font-size: 11px;
    text-transform: uppercase;
}

.soc-value {
    margin-top: 4px;
    font-weight: 600;
    word-break: break-word;
}

.soc-reasons {
    margin-top: 15px;
    padding: 12px;
    background: #0b1220;
    border-radius: 8px;
}

.soc-reasons ul {
    margin: 8px 0 0 20px;
}

.soc-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 15px;
}

.soc-btn {
    border: 0;
    border-radius: 7px;
    padding: 8px 12px;
    cursor: pointer;
    font-weight: bold;
    color: white;
}

.btn-open { background: #2563eb; }
.btn-investigating { background: #ca8a04; }
.btn-contained { background: #7c3aed; }
.btn-closed { background: #15803d; }

.soc-btn:hover {
    opacity: .8;
}

.soc-empty {
    padding: 25px;
    text-align: center;
    color: #9ca3af;
}
</style>


<style>
/* ==========================================
   PROFESSIONAL INCIDENT CARDS
========================================== */

.incident-card {
    background: linear-gradient(145deg, #111827, #0f172a);
    border: 1px solid #374151;
    border-radius: 14px;
    padding: 20px;
    margin: 15px 0;
    box-shadow: 0 8px 24px rgba(0,0,0,.25);
    transition: all .2s ease;
}

.incident-card:hover {
    transform: translateY(-2px);
    border-color: #60a5fa;
    box-shadow: 0 12px 30px rgba(0,0,0,.35);
}

.incident-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    flex-wrap: wrap;
    margin-bottom: 15px;
}

.incident-id {
    font-size: 17px;
    font-weight: 700;
    color: #f9fafb;
}

.incident-badges {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

.incident-badge {
    padding: 5px 10px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
}

.badge-critical {
    background: rgba(239,68,68,.15);
    color: #f87171;
    border: 1px solid #ef4444;
}

.badge-high {
    background: rgba(249,115,22,.15);
    color: #fb923c;
    border: 1px solid #f97316;
}

.badge-medium {
    background: rgba(234,179,8,.15);
    color: #facc15;
    border: 1px solid #eab308;
}

.badge-low {
    background: rgba(34,197,94,.15);
    color: #4ade80;
    border: 1px solid #22c55e;
}

.badge-contained {
    background: rgba(168,85,247,.15);
    color: #c084fc;
    border: 1px solid #a855f7;
}

.incident-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 12px;
    margin: 15px 0;
}

.incident-info {
    background: rgba(255,255,255,.03);
    border: 1px solid #1f2937;
    border-radius: 9px;
    padding: 11px;
}

.incident-label {
    color: #9ca3af;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .5px;
}

.incident-value {
    color: #f3f4f6;
    font-size: 14px;
    font-weight: 600;
    margin-top: 4px;
    word-break: break-word;
}

.incident-actions {
    display: flex;
    gap: 10px;
    margin-top: 15px;
}

.view-details-btn {
    background: #2563eb;
    color: white;
    border: none;
    padding: 9px 16px;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 700;
}

.view-details-btn:hover {
    background: #1d4ed8;
}

.risk-score {
    font-size: 18px;
    font-weight: 800;
}
</style>


<style>
.response-value {
    font-weight: 700;
}

.response-quarantined {
    color: #22c55e;
    font-weight: 800;
}

.response-normal {
    color: #9ca3af;
}
</style>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
/* ==========================================
   RDRS VIEW DETAILS - PROFESSIONAL BOXES
========================================== */

.rdrs-detail-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    width: 100%;
    box-sizing: border-box;
}

.rdrs-detail-grid .detail-box {
    min-width: 0;
    box-sizing: border-box;
    padding: 15px 16px;
    background: #111827;
    border: 1px solid #334155;
    border-radius: 10px;
    overflow: hidden;
}

.rdrs-detail-grid .detail-box strong {
    display: block;
    margin-bottom: 8px;
    color: #94a3b8;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: .4px;
}

.rdrs-detail-grid .detail-value {
    color: #f8fafc;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.5;
    min-width: 0;
    overflow-wrap: anywhere;
    word-break: break-word;
}

@media (max-width: 700px) {
    .rdrs-detail-grid {
        grid-template-columns: 1fr;
    }
}
</style>


<style id="rdrs-overflow-fix">
/* RDRS DETAILS OVERFLOW FIX */

#detailsModal,
#detailsModal * {
    box-sizing: border-box;
}

#detailsModal {
    overflow-y: auto !important;
    overflow-x: hidden !important;
}

#detailsModal .details-box,
#detailsModal .detail-box {
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    overflow: hidden !important;
    box-sizing: border-box !important;
}

#detailsModal .detail-value {
    max-width: 100% !important;
    min-width: 0 !important;
    overflow-wrap: anywhere !important;
    word-break: break-word !important;
    white-space: normal !important;
    overflow: hidden !important;
}

#detailsModal .detail-value[style*="monospace"] {
    font-family: monospace !important;
    font-size: 11px !important;
    line-height: 1.5 !important;
    overflow-wrap: anywhere !important;
    word-break: break-all !important;
}

#detailsModal .rdrs-detail-grid {
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    overflow: hidden !important;
}

#detailsModal .rdrs-detail-grid > * {
    min-width: 0 !important;
    max-width: 100% !important;
}

#detailsModal .reason,
#detailsModal li {
    max-width: 100% !important;
    overflow-wrap: anywhere !important;
    word-break: break-word !important;
}
</style>


<style id="rdrs-details-box-size">
/* Bigger View Details background box */

#detailsModal {
