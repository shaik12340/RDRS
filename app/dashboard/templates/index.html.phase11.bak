</div>

<div style="
    display:flex;
    gap:10px;
    margin:15px 0;
    flex-wrap:wrap;
    background:#0f172a;
    padding:15px;
    border-radius:10px;
    border:1px solid #374151;
">

    <input
        id="incidentSearch"
        type="text"
        placeholder="🔍 Search incident or filename..."
        oninput="filterIncidents()"
        style="
            flex:1;
            min-width:220px;
            padding:10px;
            border-radius:8px;
            border:1px solid #4b5563;
            background:#111827;
            color:white;
        "
    >

    <select
        id="riskFilter"
        onchange="filterIncidents()"
        style="
            padding:10px;
            border-radius:8px;
            background:#111827;
            color:white;
            border:1px solid #4b5563;
        "
    >
        <option value="ALL">All Risk Levels</option>
        <option value="CRITICAL">Critical</option>
        <option value="HIGH">High</option>
        <option value="MEDIUM">Medium</option>
        <option value="LOW">Low</option>
    </select>

    <select
        id="statusFilter"
        onchange="filterIncidents()"
        style="
            padding:10px;
            border-radius:8px;
            background:#111827;
            color:white;
            border:1px solid #4b5563;
        "
    >
        <option value="ALL">All Status</option>
        <option value="DETECTED">Detected</option>
