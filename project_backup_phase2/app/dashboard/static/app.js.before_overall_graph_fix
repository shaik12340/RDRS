/* =========================================================
   RDRS OVERALL SECURITY STATUS
   Uses /api/status - same source as dashboard counters
========================================================= */

async function loadOverallSecurityStatus() {

    try {

        const response = await fetch(
            "/api/status",
            { cache: "no-store" }
        );

        if (!response.ok) {
            throw new Error("Status API failed");
        }

        const data = await response.json();

        const stats = data.statistics || {};

        const total =
            Number(stats.total_incidents || 0);

        const open =
            Number(stats.open || 0);

        const investigating =
            Number(stats.investigating || 0);

        const contained =
            Number(stats.contained || 0);

        const closed =
            Number(stats.closed || 0);


        /* Center */

        const totalEl =
            document.getElementById("overallTotal");

        if (totalEl) {
            totalEl.textContent = total;
        }


        /* Legend */

        const openEl =
            document.getElementById("overallOpen");

        const investigatingEl =
            document.getElementById("overallInvestigating");

        const containedEl =
            document.getElementById("overallContained");

        const closedEl =
            document.getElementById("overallClosed");


        if (openEl)
            openEl.textContent = open;

        if (investigatingEl)
            investigatingEl.textContent =
                investigating;

        if (containedEl)
            containedEl.textContent =
                contained;

        if (closedEl)
            closedEl.textContent =
                closed;


        /* Circle */

        const circle =
            document.getElementById("overallCircle");

        if (!circle) {
            console.error(
                "❌ overallCircle not found"
            );
            return;
        }


        /* No incidents */

        if (total === 0) {

            circle.style.background =
                "#334155";

            return;
        }


        /* Calculate percentages */

        const openDeg =
            (open / total) * 360;

        const investigatingDeg =
            (investigating / total) * 360;

        const containedDeg =
            (contained / total) * 360;


        const p1 =
            openDeg;

        const p2 =
            p1 + investigatingDeg;

        const p3 =
            p2 + containedDeg;


        circle.style.background =
            `conic-gradient(
                #3b82f6 0deg ${p1}deg,
                #eab308 ${p1}deg ${p2}deg,
                #a855f7 ${p2}deg ${p3}deg,
                #22c55e ${p3}deg 360deg
            )`;


        console.log(
            "RDRS Overall Graph:",
            {
                total,
                open,
                investigating,
                contained,
                closed
            }
        );

    }

    catch (error) {

        console.error(
            "❌ Overall Security Graph:",
            error
        );

    }

}


/* Initial */

loadOverallSecurityStatus();


/* Live */

setInterval(
    loadOverallSecurityStatus,
    5000
);

