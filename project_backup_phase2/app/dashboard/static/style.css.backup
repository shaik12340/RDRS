*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial;
}

body{
display:flex;
background:#020617;
color:white;
}

.sidebar{
width:220px;
height:100vh;
background:#0f172a;
padding:25px;
border-right:1px solid #1e293b;
}

.sidebar h2{
color:#60a5fa;
margin-bottom:30px;
}

.sidebar ul{
list-style:none;
}

.sidebar li{
padding:14px;
margin:10px 0;
border-radius:8px;
cursor:pointer;
}

.sidebar li.active,
.sidebar li:hover{
background:#2563eb;
}

.main{
flex:1;
padding:30px;
}

.topbar{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:25px;
}

.online{
color:#22c55e;
font-weight:bold;
}

.cards{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:20px;
margin-bottom:30px;
}

.card{
padding:20px;
border-radius:14px;
box-shadow:0 8px 20px rgba(0,0,0,.4);
}

.blue{background:#2563eb;}
.purple{background:#7c3aed;}
.orange{background:#ea580c;}
.green{background:#15803d;}

.card p{
opacity:.8;
margin-bottom:8px;
}

.card h2{
font-size:32px;
}

.tablebox{
background:#111827;
padding:20px;
border-radius:14px;
}

table{
width:100%;
border-collapse:collapse;
margin-top:15px;
}

th,td{
padding:12px;
border-bottom:1px solid #374151;
text-align:left;
}

th{
color:#93c5fd;
}

/* ==========================================
   INCIDENT DETAILS MODAL FIX
========================================== */

#detailsModal {
    display: none;
    position: fixed;
    z-index: 9999;
    inset: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.75);

    overflow-y: auto;
    padding: 30px 15px;
    box-sizing: border-box;
}

#detailsModal .modal-content {
    position: relative;

    width: min(850px, 95%);
    max-height: calc(100vh - 60px);

    margin: 20px auto;

    background: #0f172a;
    color: #e2e8f0;

    border: 1px solid #334155;
    border-radius: 14px;

    padding: 28px;

    box-sizing: border-box;

    overflow-y: auto;
    overflow-x: hidden;

    box-shadow:
        0 20px 60px rgba(0,0,0,.55),
        0 0 30px rgba(59,130,246,.08);
}

/* Details heading */

#detailsModal h2 {
    margin-top: 0;
    padding-right: 40px;
    color: #f8fafc;
}

/* Long paths / hashes / IDs */

#detailsModal #detailsContent {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    overflow-wrap: anywhere;
    word-break: break-word;
}

/* Every detail row */

#detailsModal #detailsContent > div {
    max-width: 100%;
    box-sizing: border-box;
}

/* Close button */

#detailsModal .close {
    position: absolute;
    top: 14px;
    right: 18px;

    width: 34px;
    height: 34px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    color: #cbd5e1;
    font-size: 28px;
    line-height: 1;

    cursor: pointer;

    z-index: 10;
}

#detailsModal .close:hover {
    background: #1e293b;
    color: #ffffff;
}

/* Mobile */

@media (max-width: 600px) {

    #detailsModal {
        padding: 10px;
    }

    #detailsModal .modal-content {
        width: 100%;
        max-height: calc(100vh - 20px);
        margin: 5px auto;
        padding: 20px;
        border-radius: 12px;
    }

}


/* ==========================================
   HARD FIX — VIEW DETAILS NO OVERFLOW
========================================== */

#detailsModal,
#detailsModal * {
    box-sizing: border-box;
}

#detailsModal {
    position: fixed !important;
    inset: 0 !important;
    width: 100vw !important;
    height: 100vh !important;

    padding: 20px !important;

    overflow-x: hidden !important;
    overflow-y: auto !important;
}

#detailsModal .modal-content {
    width: 100% !important;
    max-width: 850px !important;

    max-height: calc(100vh - 40px) !important;

    margin: 0 auto !important;
    padding: 25px !important;

    overflow-x: hidden !important;
    overflow-y: auto !important;

    min-width: 0 !important;
}

/* Details container */

#detailsModal #detailsContent {
    display: block !important;

    width: 100% !important;
    max-width: 100% !important;

    min-width: 0 !important;

    overflow: hidden !important;
}

/* Detail boxes */

#detailsModal .detail-box {
    display: block !important;

    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;

    overflow: hidden !important;

    word-wrap: break-word !important;
    overflow-wrap: anywhere !important;
}

/* Detail values */

#detailsModal .detail-value {
    display: block !important;

    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;

    margin-top: 6px !important;

    white-space: normal !important;

    word-break: break-all !important;
    overflow-wrap: anywhere !important;

    overflow: hidden !important;
}

/* Long IDs, paths and hashes */

#detailsModal .detail-value,
#detailsModal .detail-value * {
    white-space: normal !important;
    word-break: break-all !important;
    overflow-wrap: anywhere !important;
}

/* Reasons list */

#detailsModal ul {
    width: 100% !important;
    max-width: 100% !important;

    margin: 8px 0 !important;
    padding-left: 20px !important;

    box-sizing: border-box !important;

    overflow-wrap: anywhere !important;
    word-break: break-word !important;
}

#detailsModal li {
    max-width: 100% !important;

    white-space: normal !important;

    overflow-wrap: anywhere !important;
    word-break: break-word !important;
}

/* Close button must stay inside */

#detailsModal .close {
    position: absolute !important;

    top: 10px !important;
    right: 12px !important;

    z-index: 100 !important;
}

/* Mobile */

@media (max-width: 600px) {

    #detailsModal {
        padding: 8px !important;
    }

    #detailsModal .modal-content {
        width: 100% !important;
        max-height: calc(100vh - 16px) !important;

        padding: 20px 15px !important;
    }

}



/* ==========================================
   FINAL INCIDENT DETAILS MODAL FIX
========================================== */

#detailsModal {
    position: fixed !important;
    inset: 0 !important;

    width: 100vw !important;
    height: 100vh !important;

    max-width: 100vw !important;
    max-height: 100vh !important;

    box-sizing: border-box !important;

    padding: 20px !important;

    display: none;
    align-items: center !important;
    justify-content: center !important;

    overflow: hidden !important;

    z-index: 99999 !important;
}


/* When modal is opened */

#detailsModal[style*="display: block"],
#detailsModal.show {
    display: flex !important;
}


/* ==========================================
   MODAL OUTER BOX
========================================== */

#detailsModal .modal-content {

    position: relative !important;

    box-sizing: border-box !important;

    width: min(760px, calc(100vw - 40px)) !important;

    max-width: min(760px, calc(100vw - 40px)) !important;

    height: auto !important;

    max-height: calc(100vh - 40px) !important;

    min-width: 0 !important;

    margin: 0 !important;

    padding: 28px !important;

    border-radius: 16px !important;

    overflow-x: hidden !important;
    overflow-y: auto !important;

    word-wrap: break-word !important;

    overflow-wrap: anywhere !important;

}


/* ==========================================
   MODAL HEADING
========================================== */

#detailsModal h2 {

    width: 100% !important;

    max-width: 100% !important;

    box-sizing: border-box !important;

    padding-right: 35px !important;

    margin-top: 0 !important;

    overflow-wrap: anywhere !important;

    word-break: break-word !important;

}


/* ==========================================
   DETAILS CONTAINER
========================================== */

#detailsModal #detailsContent {

    display: flex !important;

    flex-direction: column !important;

    gap: 12px !important;

    width: 100% !important;

    max-width: 100% !important;

    min-width: 0 !important;

    box-sizing: border-box !important;

    overflow: visible !important;

}


/* ==========================================
   INDIVIDUAL DETAIL BOX
========================================== */

#detailsModal .detail-box {

    display: block !important;

    box-sizing: border-box !important;

    width: 100% !important;

    max-width: 100% !important;

    min-width: 0 !important;

    padding: 13px 15px !important;

    margin: 0 !important;

    border-radius: 10px !important;

    overflow: hidden !important;

    word-wrap: break-word !important;

    overflow-wrap: anywhere !important;

}


/* ==========================================
   DETAIL LABEL
========================================== */

#detailsModal .detail-box strong {

    display: block !important;

    width: 100% !important;

    max-width: 100% !important;

    box-sizing: border-box !important;

    margin-bottom: 6px !important;

    overflow-wrap: anywhere !important;

    word-break: break-word !important;

}


/* ==========================================
   DETAIL VALUE
========================================== */

#detailsModal .detail-value {

    display: block !important;

    box-sizing: border-box !important;

    width: 100% !important;

    max-width: 100% !important;

    min-width: 0 !important;

    margin-top: 5px !important;

    padding: 0 !important;

    white-space: normal !important;

    word-break: break-all !important;

    overflow-wrap: anywhere !important;

    overflow: hidden !important;

}


/* ==========================================
   LONG PATHS
========================================== */

#detailsModal .detail-value {

    line-height: 1.55 !important;

}


#detailsModal .detail-value * {

    max-width: 100% !important;

    white-space: normal !important;

    word-break: break-all !important;

    overflow-wrap: anywhere !important;

}


/* ==========================================
   SHA-256
========================================== */

#detailsModal .detail-box:has(.detail-value[style*="monospace"]) {

    overflow: hidden !important;

}


#detailsModal .detail-value[style*="monospace"] {

    font-size: 11px !important;

    line-height: 1.5 !important;

    letter-spacing: 0 !important;

    word-break: break-all !important;

    overflow-wrap: anywhere !important;

}


/* ==========================================
   RISK REASONS
========================================== */

#detailsModal ul {

    box-sizing: border-box !important;

    width: 100% !important;

    max-width: 100% !important;

    min-width: 0 !important;

    margin: 8px 0 0 0 !important;

    padding-left: 20px !important;

    overflow: hidden !important;

}


#detailsModal li {

    box-sizing: border-box !important;

    width: 100% !important;

    max-width: 100% !important;

    white-space: normal !important;

    word-break: break-word !important;

    overflow-wrap: anywhere !important;

    margin: 6px 0 !important;

}


/* ==========================================
   CLOSE BUTTON
========================================== */

#detailsModal .close {

    position: absolute !important;

    top: 10px !important;

    right: 14px !important;

    width: 32px !important;

    height: 32px !important;

    line-height: 28px !important;

    text-align: center !important;

    z-index: 100000 !important;

}


/* ==========================================
   MOBILE
========================================== */

@media (max-width: 600px) {

    #detailsModal {

        padding: 8px !important;

    }

    #detailsModal .modal-content {

        width: calc(100vw - 16px) !important;

        max-width: calc(100vw - 16px) !important;

        max-height: calc(100vh - 16px) !important;

        padding: 22px 15px !important;

        border-radius: 12px !important;

    }

    #detailsModal .detail-box {

        padding: 11px 12px !important;

    }

    #detailsModal .detail-value[style*="monospace"] {

        font-size: 10px !important;

    }

}


/* ==========================================
   NEVER ALLOW MODAL CONTENT TO ESCAPE
========================================== */

#detailsModal *,
#detailsModal *::before,
#detailsModal *::after {

    box-sizing: border-box !important;

    max-width: 100% !important;

}



/* =====================================================
   RDRS - FINAL INCIDENT DETAILS MODAL
   ===================================================== */

#detailsModal {
    position: fixed !important;
    inset: 0 !important;

    width: 100% !important;
    height: 100% !important;

    padding: 20px !important;

    display: none;

    align-items: center !important;
