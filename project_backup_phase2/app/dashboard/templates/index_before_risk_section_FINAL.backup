<script>

const fileInput =
    document.getElementById("fileInput");

const selectedFiles =
    document.getElementById("selectedFiles");

const results =
    document.getElementById("results");

const message =
    document.getElementById("message");


/* ==========================================
   FILE SELECTION
========================================== */

fileInput.addEventListener("change", function () {

    const files = Array.from(fileInput.files);

    if (files.length === 0) {

        selectedFiles.innerHTML =
            "No files selected.";

        return;
    }

    selectedFiles.innerHTML =
        `<strong>${files.length} file(s) selected:</strong><br>` +

        files.map((file, index) => `
            <div style="
                margin: 6px 0;
                padding: 6px 10px;
                background: #0f172a;
                border-radius: 6px;
            ">
                📄 <strong>${index + 1}.</strong>
                ${escapeHtml(file.name)}
                — ${file.size} bytes
            </div>
        `).join("");

});



/* ==========================================
   SCAN FILES
========================================== */

async function scanFiles() {

    const files = fileInput.files;

    if (files.length === 0) {

        alert(
            "Please select at least one file."
        );

        return;
    }

    const button =
        document.getElementById("scanButton");

    button.disabled = true;

    button.innerText =
        "🔄 SCANNING...";

    message.innerHTML =
        `<p class="info">
            🔄 Uploading and analyzing
            ${files.length} file(s)...
        </p>`;

    results.innerHTML = "";

    try {

        for (const file of files) {

            await scanSingleFile(file);

        }

        message.innerHTML =
            `<p class="success">
                ✅ Scan completed successfully.
            </p>`;

        await loadIncidents();

    }

    catch (error) {

        message.innerHTML =
            `<p class="error">
                ❌ ${escapeHtml(error.message)}
            </p>`;

    }

    finally {

        button.disabled = false;

        button.innerText =
            "🔍 SCAN FILES";

    }

}


/* ==========================================
   SINGLE FILE SCAN
========================================== */

async function scanSingleFile(file) {

    const formData =
        new FormData();

    formData.append(
        "file",
        file
    );

    const response =
        await fetch(
            "/api/upload",
            {
                method: "POST",
                body: formData
            }
        );

    const data =
        await response.json();

    if (!response.ok) {

        let errorMessage = "File scan failed";

        if (typeof data.detail === "string") {
            errorMessage = data.detail;
        }
        else if (data.detail) {
            errorMessage =
                data.detail.message ||
                data.detail.error ||
                JSON.stringify(data.detail);
        }
        else if (data.message) {
            errorMessage = data.message;
        }

        throw new Error(errorMessage);

    }

    displayResult(
        data
    );

}


/* ==========================================
   DISPLAY RESULT
========================================== */

function displayResult(data) {

    const result = data.scan_result || {};
    const incident = data.incident || null;

    const fileName =
        data.file?.name ||
        result.filename ||
        "Unknown file";

    const fileSize =
        data.file?.size ??
        result.size ??
        0;

    const sha256 =
        data.file?.sha256 ||
        result.sha256 ||
        "";

    const riskScore =
        result.risk_score ?? 0;

    const riskLevel =
        result.risk_level || "LOW";

    const suspicious =
        result.suspicious === true;

    const reasons =
        Array.isArray(result.risk_reasons) &&
        result.risk_reasons.length > 0

        ?

        result.risk_reasons
            .map(reason =>
                `<div class="reason">
                    ⚠️ ${escapeHtml(reason)}
                </div>`
            )
            .join("")

        :

        `<div class="success">
            ✓ No suspicious indicators detected
        </div>`;

    const responseStatus =
        incident?.response?.status ||
        "not_applicable";

    const resultBox =
        document.createElement("div");

    resultBox.className = "result";

    resultBox.innerHTML = `

        <h3>
            📄 ${escapeHtml(fileName)}
        </h3>

        <p>
            📦 <strong>Size:</strong>
            ${fileSize} bytes
        </p>

        <p>
            📊 <strong>Entropy:</strong>
            ${result.entropy ?? 0}
        </p>

        <p>
            🔐 <strong>SHA-256:</strong>
        </p>

        <div class="hash">
            ${escapeHtml(sha256)}
        </div>

        <p>
            🎯 <strong>Risk Score:</strong>
            ${riskScore}/100
        </p>

        <p>
            🚨 <strong>Risk Level:</strong>
            <span class="${escapeHtml(riskLevel)}">
                ${escapeHtml(riskLevel)}
            </span>
        </p>

        <p>
            🔎 <strong>Suspicious:</strong>
            ${
                suspicious
                ? '<span class="CRITICAL">YES</span>'
                : '<span class="success">NO</span>'
            }
        </p>

        <p>
            📝 <strong>Risk Reasons:</strong>
        </p>

        ${reasons}

        ${
            incident
            ?

            `
                <hr>

                <p>
                    🆔 <strong>Incident ID:</strong>
                </p>

                <div class="incident">
                    ${escapeHtml(incident.incident_id || "N/A")}
                </div>

                <p>
                    ⚡ <strong>Event:</strong>
                    ${escapeHtml(incident.event_type || "UPLOADED")}
                </p>

                <p>
                    🛡️ <strong>Response:</strong>
                    <span class="${
                        responseStatus === "quarantined"
                        ? "CRITICAL"
                        : "success"
                    }">
                        ${escapeHtml(responseStatus)}
                    </span>
                </p>
            `

            :

            `
                <hr>

                <p>
                    🛡️ <strong>Response:</strong>
                    <span class="success">
                        NO ACTION REQUIRED
                    </span>
                </p>

                <div class="success">
                    ✓ No security incident created for this file
                </div>
            `
        }

    `;

    const results =
        document.getElementById("results");

    if (results) {
        results.appendChild(resultBox);
    }

}

function viewDetailsById(incidentId) {

    const incident = allIncidents.find(
        item => item.incident_id === incidentId
    );

    if (!incident) {
        console.error("Incident not found:", incidentId);
        alert("Incident details not found.");
        return;
    }

    viewDetails(incident);
}


function viewDetails(incident) {

    const modal = document.getElementById("detailsModal");
    const content = document.getElementById("detailsContent");

    if (!modal || !content) {
        console.error("Incident details modal elements not found.");
        return;
    }

    const riskLevel =
        String(
            incident.risk_level ||
            incident.severity ||
            "LOW"
        ).toUpperCase();

    const status =
        String(
            incident.status ||
            "OPEN"
        ).toUpperCase();

    const responseStatus =
        String(
            incident.response?.status ||
            "no_action"
        ).toLowerCase();

    const riskScore =
        incident.risk_score ?? 0;

    const entropy =
        incident.analysis?.entropy ??
        incident.entropy ??
        "N/A";

    const suspicious =
        incident.analysis?.suspicious === true ||
        incident.suspicious === true
            ? "YES"
            : "NO";

    const fileName =
        incident.file?.name ||
        "Unknown";

    const filePath =
        incident.file?.path ||
        "Unknown";

    const sha256 =
        incident.file?.sha256 ||
        "Unknown";

    const quarantinePath =
        incident.response?.quarantine_path ||
        "Not quarantined";

    const originalPath =
        incident.response?.original_path ||
        filePath ||
        "Unknown";

    const fileSize =
        incident.file?.size ??
        "N/A";

    const reasons =
        Array.isArray(incident.risk_reasons) &&
        incident.risk_reasons.length

        ?

        incident.risk_reasons
            .map(reason => `
                <div class="reason">
                    ⚠️ ${escapeHtml(reason)}
                </div>
            `)
            .join("")

        :

        `
            <div class="success">
                ✓ No suspicious indicators
            </div>
        `;


    const responseLabel =
        responseStatus === "quarantined"
            ? "🔒 QUARANTINED"
            : responseStatus === "no_action"
                ? "NO ACTION"
                : responseStatus.toUpperCase();


    const responseClass =
        responseStatus === "quarantined"
            ? "response-quarantined"
            : "response-normal";


    let historyHtml = `
        <div class="history-empty">
            No status history available.
        </div>
    `;


    if (
        Array.isArray(incident.status_history) &&
        incident.status_history.length
    ) {

        historyHtml = `
            <div class="history">
                ${
                    incident.status_history
                        .map(item => `
                            <div class="history-item">
                                <span>
                                    ${escapeHtml(item.from || "UNKNOWN")}
                                </span>

                                <span class="history-arrow">
                                    →
                                </span>

                                <strong>
                                    ${escapeHtml(item.to || "UNKNOWN")}
                                </strong>
                            </div>
                        `)
                        .join("")
                }
            </div>
        `;
    }


    content.innerHTML = `

        <div class="details-header">

            <div>
                <div class="details-subtitle">
                    SECURITY INCIDENT
                </div>

                <div class="details-incident-id">
                    🚨 ${escapeHtml(
                        incident.incident_id ||
                        "Unknown"
                    )}
                </div>
            </div>

            <div class="details-header-badges">

                <span class="risk-badge ${riskLevel.toLowerCase()}">
                    ${escapeHtml(riskLevel)}
                </span>

                <span class="status-badge ${status.toLowerCase()}">
                    ${escapeHtml(status)}
                </span>

            </div>

        </div>


        <div class="details-section">

            <div class="details-section-title">
                📋 INCIDENT INFORMATION
            </div>


            <div class="details-grid">

                <div class="detail-card">

                    <div class="detail-label">
                        🆔 INCIDENT ID
                    </div>

                    <div class="detail-value">
                        ${escapeHtml(
                            incident.incident_id ||
                            "Unknown"
                        )}
                    </div>

                </div>


                <div class="detail-card">

                    <div class="detail-label">
                        🕒 TIMESTAMP
                    </div>

                    <div class="detail-value">
                        ${escapeHtml(
                            incident.timestamp ||
                            "Unknown"
                        )}
                    </div>

                </div>


                <div class="detail-card">

                    <div class="detail-label">
                        ⚡ EVENT TYPE
                    </div>

                    <div class="detail-value">
                        ${escapeHtml(
                            incident.event_type ||
                            "UNKNOWN"
                        )}
                    </div>

                </div>


                <div class="detail-card">

                    <div class="detail-label">
                        📊 INCIDENT STATUS
                    </div>

                    <div class="detail-value">
                        ${escapeHtml(status)}
                    </div>

                </div>

            </div>

        </div>


        <div class="details-section">

            <div class="details-section-title">
                🎯 RISK ANALYSIS
            </div>


            <div class="details-grid">

                <div class="detail-card risk-score-card">

                    <div class="detail-label">
                        🎯 RISK SCORE
                    </div>

                    <div class="detail-value large">
                        ${riskScore}/100
                    </div>

                </div>


                <div class="detail-card">

                    <div class="detail-label">
                        🚨 SEVERITY
                    </div>

                    <div class="detail-value">
                        ${escapeHtml(riskLevel)}
                    </div>

                </div>


                <div class="detail-card">

                    <div class="detail-label">
                        📊 ENTROPY
                    </div>

                    <div class="detail-value">
                        ${escapeHtml(entropy)}
                    </div>

                </div>


                <div class="detail-card">

                    <div class="detail-label">
                        🔎 SUSPICIOUS
                    </div>

                    <div class="detail-value">
                        ${suspicious}
                    </div>

                </div>

            </div>

        </div>


        <div class="details-section">

            <div class="details-section-title">
                📁 FILE INFORMATION
            </div>


            <div class="details-grid">

                <div class="detail-card full-width">

                    <div class="detail-label">
                        📄 FILE NAME
                    </div>

                    <div class="detail-value">
                        ${escapeHtml(fileName)}
                    </div>

                </div>


                <div class="detail-card full-width">

                    <div class="detail-label">
                        📁 ORIGINAL FILE PATH
                    </div>

                    <div class="detail-value path-value">
                        ${escapeHtml(originalPath)}
                    </div>

                </div>


                <div class="detail-card full-width">

                    <div class="detail-label">
                        📂 CURRENT FILE PATH
                    </div>

                    <div class="detail-value path-value">
                        ${escapeHtml(filePath)}
                    </div>

                </div>


                <div class="detail-card">

                    <div class="detail-label">
                        📦 FILE SIZE
                    </div>

                    <div class="detail-value">
                        ${escapeHtml(fileSize)} bytes
                    </div>

                </div>


                <div class="detail-card">

                    <div class="detail-label">
                        🔐 SHA-256
                    </div>

                    <div class="detail-value hash">
                        ${escapeHtml(sha256)}
                    </div>

                </div>

            </div>

        </div>


        <div class="details-section">

            <div class="details-section-title">
                📝 DETECTION REASONS
            </div>

            <div class="reasons-container">
                ${reasons}
            </div>

        </div>


        <div class="details-section">

            <div class="details-section-title">
                🛡️ RESPONSE & CONTAINMENT
            </div>


            <div class="details-grid">

                <div class="detail-card">

                    <div class="detail-label">
                        🛡️ RESPONSE ACTION
                    </div>

                    <div class="detail-value ${responseClass}">
                        ${escapeHtml(responseLabel)}
                    </div>

                </div>


                <div class="detail-card">

                    <div class="detail-label">
                        🔒 QUARANTINE STATUS
                    </div>

                    <div class="detail-value">
                        ${
                            responseStatus === "quarantined"
                                ? "CONTAINED"
                                : "NOT QUARANTINED"
                        }
                    </div>

                </div>


                <div class="detail-card full-width">

                    <div class="detail-label">
                        🔒 QUARANTINE PATH
                    </div>

                    <div class="detail-value path-value">
                        ${escapeHtml(quarantinePath)}
                    </div>

                </div>

            </div>

        </div>


        <div class="details-section">

            <div class="details-section-title">
                📋 STATUS HISTORY
            </div>

            ${historyHtml}

        </div>

    `;


    modal.style.display = "block";

}


/* ==========================================
   CLOSE DETAILS
========================================== */

function closeDetails() {

    document.getElementById(
        "detailsModal"
    ).style.display = "none";

}


window.onclick =
    function(event) {

        const modal =
            document.getElementById(
                "detailsModal"
            );

        if (event.target === modal) {

            modal.style.display =
                "none";

        }

    };


/* ==========================================
   HTML SAFETY
========================================== */

function escapeHtml(value) {

    if (value === null ||
        value === undefined) {

        return "";

    }

    return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");

}

</script>


<script>
let allIncidents = [];


async function loadIncidents() {

    const container = document.getElementById("incidents");
    const message = document.getElementById("incidentMessage");

    container.innerHTML = "<p>🔄 Loading incidents...</p>";

    try {

        const response = await fetch("/api/incidents");

        if (!response.ok) {
            throw new Error("Failed to load incidents");
        }

        const incidents = await response.json();

        if (!Array.isArray(incidents)) {
            throw new Error("Invalid incident data");
        }

        const seen = new Set();

        allIncidents = incidents.filter(incident => {

            if (!incident || !incident.incident_id) {
                return false;
            }

            if (seen.has(incident.incident_id)) {
                return false;
            }

            seen.add(incident.incident_id);
            return true;

        });

        filterIncidents();

        if (typeof loadIncidentStats === "function") {
            await loadIncidentStats();
        }

    } catch (error) {

        console.error(error);

        container.innerHTML =
            "<p>❌ Failed to load security incidents.</p>";

        message.innerHTML =
            `<span style="color:red">${error.message}</span>`;
    }
}


function filterIncidents() {

    const container =
        document.getElementById("incidents");

    const message =
        document.getElementById("incidentMessage");

    const searchElement =
        document.getElementById("incidentSearch");

    const riskElement =
        document.getElementById("riskFilter");

    const statusElement =
        document.getElementById("statusFilter");

    const search =
        (searchElement?.value || "")
        .trim()
        .toLowerCase();

    const risk =
        riskElement?.value || "ALL";

    const status =
        statusElement?.value || "ALL";


    const filtered = allIncidents.filter(incident => {

        const fileName =
            incident.file?.name || "";

        const incidentId =
            incident.incident_id || "";

        const level =
            String(
                incident.risk_level || "LOW"
            ).toUpperCase();

        const incidentStatus =
            String(
                incident.status || "OPEN"
            ).toUpperCase();


        const matchesSearch =
            !search ||
            incidentId.toLowerCase().includes(search) ||
            fileName.toLowerCase().includes(search);

        const matchesRisk =
            risk === "ALL" ||
            level === risk;

        const matchesStatus =
            status === "ALL" ||
            incidentStatus === status;


        return (
            matchesSearch &&
            matchesRisk &&
            matchesStatus
        );

    });


    container.innerHTML = "";


    if (filtered.length === 0) {

        container.innerHTML =
            "<p>🔎 No matching incidents found.</p>";

        message.innerHTML =
            `Showing 0 of ${allIncidents.length} incident(s).`;

        return;
    }


    filtered.forEach(incident => {

        const reasons =
            Array.isArray(incident.risk_reasons) &&
            incident.risk_reasons.length
                ? incident.risk_reasons
                    .map(r => `<li>${escapeHtml(r)}</li>`)
                    .join("")
                : "<li>No suspicious indicators</li>";


        const level =
            String(
                incident.risk_level || "LOW"
            ).toUpperCase();

        const status =
            String(
                incident.status || "OPEN"
            ).toUpperCase();

        const levelClass =
            level.toLowerCase();

        const statusClass =
            status.toLowerCase();

        container.innerHTML += `
            <div class="incident-card">

                <div class="incident-card-header">

                    <div>
                        <div class="incident-label">
                            SECURITY INCIDENT
                        </div>

                        <h3>
                            🚨 ${escapeHtml(
                                incident.incident_id
                            )}
                        </h3>
                    </div>

                    <div class="incident-badges">

                        <span class="risk-badge ${levelClass}">
                            ${escapeHtml(level)}
                        </span>

                        <span class="status-badge ${statusClass}">
                            ${escapeHtml(status)}
                        </span>

                    </div>

                </div>


                <div class="incident-main">


                    <div class="incident-info">

                        <div class="info-item">
                            <span class="info-label">
                                📄 FILE
                            </span>

                            <span class="info-value">
                                ${escapeHtml(
                                    incident.file?.name ||
                                    "Unknown"
                                )}
                            </span>
                        </div>


                        <div class="info-item">
                            <span class="info-label">
                                🎯 RISK SCORE
                            </span>

                            <span class="info-value score">
                                ${incident.risk_score ?? 0}/100
                            </span>
                        </div>


                        <div class="info-item">
                            <span class="info-label">
                                ⚡ EVENT
                            </span>

                            <span class="info-value">
                                ${escapeHtml(
                                    incident.event_type ||
                                    "UNKNOWN"
                                )}
                            </span>
                        </div>


                        <div class="info-item">
                            <span class="info-label">
                                📊 ENTROPY
                            </span>

                            <span class="info-value">
                                ${incident.analysis?.entropy ?? incident.entropy ?? "N/A"}
                            </span>
                        </div>


                        <div class="info-item">
                            <span class="info-label">
                                🔎 SUSPICIOUS
                            </span>

                            <span class="info-value">
                                ${(incident.analysis?.suspicious ?? incident.suspicious) === true
                                    ? "YES"
                                    : "NO"}
                            </span>
                        </div>


                        <div class="info-item">
                            <span class="info-label">
                                🛡️ RESPONSE
                            </span>

                            <span class="info-value response-value
                                ${incident.response?.status === "quarantined"
                                    ? "response-quarantined"
                                    : "response-normal"}">
                                ${incident.response?.status === "quarantined"
                                    ? "🔒 QUARANTINED"
                                    : escapeHtml(
                                        incident.response?.status ||
                                        "NO ACTION"
                                    ).toUpperCase()}
                            </span>
                        </div>


                    </div>


                    <div class="incident-reasons">

                        <div class="info-label">
                            📝 DETECTION REASONS
                        </div>

                        <ul>
                            ${reasons}
                        </ul>

                    </div>


                </div>


                <div class="incident-footer">

                    <span class="incident-time">
                        🕒 ${escapeHtml(
                            incident.timestamp ||
                            "Unknown"
                        )}
                    </span>

                    <button
                        class="details-button"
                        type="button"
                        onclick="viewDetailsById('${escapeHtml(incident.incident_id)}')"
                    >
                        🔎 VIEW DETAILS
                    </button>

                </div>

            </div>
        `;
    });


    message.innerHTML =
        `✅ Showing ${filtered.length} of ` +
        `${allIncidents.length} unique incident(s).`;
}


document.addEventListener("DOMContentLoaded", loadIncidents);


</script>





<script>

function updateRDRSCharts(stats) {

    const critical = Number(stats.critical ?? 0);
    const high = Number(stats.high ?? 0);
    const medium = Number(stats.medium ?? 0);
    const low = Number(stats.low ?? 0);

    const total = Number(stats.total_incidents ?? 0);

    /* =========================
       RISK TOTAL
    ========================= */

    const totalEl =
        document.getElementById("riskTotalValue");

    if (totalEl) {
        totalEl.textContent = total;
    }

    /* =========================
       RISK LEGEND
    ========================= */

    const riskMap = {
        riskCriticalValue: critical,
        riskHighValue: high,
        riskMediumValue: medium,
        riskLowValue: low
    };

    Object.entries(riskMap).forEach(([id, value]) => {

        const el = document.getElementById(id);

        if (el) {
            el.textContent = value;
        }

    });

    /* =========================
       DONUT GRAPH
    ========================= */

    const donut =
        document.getElementById("rdrsRiskChart");

    if (donut) {

        if (total <= 0) {

            donut.style.background = "#374151";

        } else {

            const criticalDeg =
                (critical / total) * 360;

            const highDeg =
                (high / total) * 360;

            const mediumDeg =
                (medium / total) * 360;

            const criticalEnd =
                criticalDeg;

            const highEnd =
                criticalEnd + highDeg;

            const mediumEnd =
                highEnd + mediumDeg;

            donut.style.background =
                `conic-gradient(
                    #ef4444 0deg ${criticalEnd}deg,
                    #f97316 ${criticalEnd}deg ${highEnd}deg,
                    #eab308 ${highEnd}deg ${mediumEnd}deg,
                    #22c55e ${mediumEnd}deg 360deg
                )`;

        }

    }

    /* =========================
       INCIDENT STATUS
    ========================= */

    const open =
        Number(stats.open ?? 0);

    const investigating =
        Number(stats.investigating ?? 0);

    const contained =
        Number(stats.contained ?? 0);

    const closed =
        Number(stats.closed ?? 0);

    const statusMap = {

        openChartValue: open,

        investigatingChartValue:
            investigating,

        containedChartValue:
            contained,

        closedChartValue:
            closed

    };

    Object.entries(statusMap).forEach(([id, value]) => {

        const el =
            document.getElementById(id);

        if (el) {
            el.textContent = value;
        }

    });

    const maxStatus =
        Math.max(
            open,
            investigating,
            contained,
            closed,
            1
        );

    const barMap = {

        openBar: open,

        investigatingBar:
            investigating,

        containedBar:
            contained,

        closedBar:
            closed

    };

    Object.entries(barMap).forEach(([id, value]) => {

        const bar =
            document.getElementById(id);

        if (bar) {

            bar.style.width =
                ((value / maxStatus) * 100) + "%";

        }

    });

}


/* =================================
   LOAD LIVE INCIDENT STATISTICS
================================= */

async function loadIncidentStats() {

    try {

        const response =
            await fetch("/api/status");

        if (!response.ok) {
            throw new Error(
                "Failed to load system statistics"
            );
        }

        const data =
            await response.json();

        const stats =
            data.statistics || {};

        /* Update graphs */

        updateRDRSCharts(stats);

        /* Update statistic cards */

        const fields = {

            totalIncidents:
                stats.total_incidents ?? 0,

            criticalIncidents:
                stats.critical ?? 0,

            highIncidents:
                stats.high ?? 0,

            mediumIncidents:
                stats.medium ?? 0,

            lowIncidents:
                stats.low ?? 0,

            quarantinedIncidents:
                stats.quarantined ?? 0,

            openIncidents:
                stats.open ?? 0,

            investigatingIncidents:
                stats.investigating ?? 0,

            containedIncidents:
                stats.contained ?? 0,

            closedIncidents:
                stats.closed ?? 0

        };

        Object.entries(fields).forEach(
            ([id, value]) => {

                const el =
                    document.getElementById(id);

                if (el) {
                    el.textContent = value;
                }

            }
        );

        console.log(
            "✅ RDRS analytics updated:",
            stats
        );

    } catch (error) {

        console.error(
            "❌ Failed to load incident statistics:",
            error
        );

    }

}


/* =================================
   INITIAL LOAD + AUTO REFRESH
================================= */

document.addEventListener(
    "DOMContentLoaded",
    () => {

        loadIncidentStats();

        setInterval(
            loadIncidentStats,
            10000
        );

    }
);

</script>





<script>
async function cleanSystem() {

    if (!confirm(
        "Are you sure you want to clean the RDRS scan data?"
    )) {
        return;
    }

    const message =
        document.getElementById("incidentMessage");

    const container =
        document.getElementById("incidents");

    const results =
        document.getElementById("results");

    const fileInput =
        document.getElementById("fileInput");

    const selectedFiles =
        document.getElementById("selectedFiles");

    try {

        if (message) {
            message.innerHTML =
                "🧹 Cleaning RDRS scan data...";
        }

        const response =
            await fetch(
                "/api/incidents/clean",
                {
                    method: "DELETE"
                }
            );

        if (!response.ok) {
            throw new Error(
                "Failed to clean RDRS scan data"
            );
        }

        const result =
            await response.json();

        /* ==========================================
           CLEAR INCIDENT DASHBOARD
        ========================================== */

        allIncidents = [];

        if (container) {
            container.innerHTML =
                "<p>✅ No incidents found.</p>";
        }

        /* ==========================================
           CLEAR SCAN RESULTS
        ========================================== */

        if (results) {
            results.innerHTML = "";
        }

        /* ==========================================
           CLEAR SELECTED FILES
        ========================================== */

        if (fileInput) {
            fileInput.value = "";
        }

        if (selectedFiles) {
            selectedFiles.innerHTML =
                "No files selected.";
        }

        /* ==========================================
           RESET FILTERS
        ========================================== */

        const search =
            document.getElementById(
                "incidentSearch"
            );

        const risk =
            document.getElementById(
                "riskFilter"
            );

        const status =
            document.getElementById(
                "statusFilter"
            );

        if (search) {
            search.value = "";
        }

        if (risk) {
            risk.value = "ALL";
        }

        if (status) {
            status.value = "ALL";
        }

        /* ==========================================
           RESET STATISTICS
        ========================================== */

        const statIds = [
            "totalIncidents",
            "criticalIncidents",
            "highIncidents",
            "mediumIncidents",
            "lowIncidents",
            "quarantinedIncidents"
        ];

        statIds.forEach(id => {

            const element =
                document.getElementById(id);

            if (element) {
                element.textContent = "0";
            }

        });

        /* ==========================================
           SUCCESS MESSAGE
        ========================================== */

        const deleted =
            result.deleted_uploads ?? 0;

        if (message) {
            message.innerHTML =
                `<p class="success">
                    🧹 RDRS system cleaned successfully.<br>
                    🗑️ ${deleted} uploaded scan file(s) removed.<br>
                    📋 Incident history cleared.<br>
                    🔄 Scanner reset.
                </p>`;
        }

    } catch (error) {

        console.error(error);

        if (message) {
            message.innerHTML =
                `<p class="error">
                    ❌ ${escapeHtml(error.message)}
                </p>`;
        }

    }

}
</script>



<script>

/* =========================================================
   RDRS LOGOUT
========================================================= */

function logoutRDRS() {

    if (
        confirm(
            "Logout from RDRS Security Dashboard?"
        )
    ) {

        window.location.href =
            "/login";

    }

}

</script>


</body>

</html>
