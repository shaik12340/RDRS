        conic-gradient(
            #ef4444 0deg,
            #ef4444 0deg,
            #f97316 0deg,
            #f97316 0deg,
            #eab308 0deg,
            #eab308 0deg,
            #22c55e 0deg,
            #22c55e 360deg
        );

    display:flex;

    align-items:center;

    justify-content:center;

    position:relative;

    transition:.5s;

}


.risk-donut::before {

    content:"";

