<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>RDRS Security Dashboard</title>

    <style>

/* =========================================================
   RDRS PROFESSIONAL SOC DASHBOARD UI
   Frontend only - Detection/Response backend untouched
========================================================= */

:root {
    --rdrs-bg: #07111f;
    --rdrs-panel: #0d1a2b;
    --rdrs-panel-2: #111f33;
    --rdrs-border: #22334a;
    --rdrs-text: #e5edf7;
    --rdrs-muted: #8291a6;
    --rdrs-blue: #38bdf8;
    --rdrs-green: #34d399;
    --rdrs-red: #f87171;
    --rdrs-orange: #fb923c;
    --rdrs-yellow: #facc15;
    --rdrs-purple: #a78bfa;
}

/* ---------- GLOBAL ---------- */

body {
    background:
        radial-gradient(circle at 10% 0%, rgba(56,189,248,.07), transparent 30%),
        radial-gradient(circle at 90% 10%, rgba(167,139,250,.06), transparent 30%),
        var(--rdrs-bg) !important;
    color: var(--rdrs-text);
}

* {
    scrollbar-width: thin;
    scrollbar-color: #26384f transparent;
}

/* ---------- DASHBOARD PANELS ---------- */

.card,
.panel,
.dashboard-card,
.stat-card,
.scanner-card,
.incident-card,
.modal-content {
    background: linear-gradient(
        145deg,
        rgba(17,31,51,.98),
        rgba(10,22,38,.98)
    ) !important;

    border: 1px solid var(--rdrs-border) !important;
    box-shadow: 0 12px 35px rgba(0,0,0,.20);
}

/* ---------- STATISTICS ---------- */

.stat-card {
    position: relative;
    overflow: hidden;
    border-radius: 14px !important;
    padding: 20px !important;
    transition: transform .2s ease, border-color .2s ease;
}

.stat-card::after {
    content: "";
    position: absolute;
    right: -30px;
    top: -30px;
    width: 90px;
    height: 90px;
    border-radius: 50%;
    background: rgba(56,189,248,.05);
}

.stat-card:hover {
    transform: translateY(-3px);
    border-color: #35516f !important;
}

.stat-title {
    color: var(--rdrs-muted) !important;
    font-size: 11px !important;
    font-weight: 700 !important;
    letter-spacing: 1px;
}

.stat-number {
    color: #f8fafc !important;
    font-size: 30px !important;
    font-weight: 800 !important;
    margin-top: 6px;
}

/* ---------- STATUS COLORS ---------- */

.critical,
.risk-badge.critical {
    color: #fca5a5 !important;
}

.high,
.risk-badge.high {
    color: #fdba74 !important;
}

.medium,
.risk-badge.medium {
    color: #fde047 !important;
}

.low,
.risk-badge.low {
    color: #86efac !important;
}

/* ---------- INCIDENT CARD ---------- */

.incident-card {
    position: relative;
    border-radius: 16px !important;
    padding: 20px !important;
    margin-bottom: 16px;
    overflow: hidden;
    transition:
        transform .2s ease,
        border-color .2s ease,
        box-shadow .2s ease;
}

.incident-card::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: var(--rdrs-blue);
}

.incident-card:hover {
    transform: translateY(-2px);
    border-color: #35516f !important;
    box-shadow: 0 16px 40px rgba(0,0,0,.28);
}

.incident-card.critical::before {
    background: var(--rdrs-red);
}

.incident-card.high::before {
    background: var(--rdrs-orange);
}

.incident-card.medium::before {
    background: var(--rdrs-yellow);
}

.incident-card.low::before {
    background: var(--rdrs-green);
}

/* ---------- INCIDENT HEADER ---------- */

.incident-card-header {
    display: flex !important;
    align-items: flex-start !important;
    justify-content: space-between !important;
    gap: 18px !important;
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(148,163,184,.10);
}

.incident-label {
    color: #64748b !important;
    font-size: 10px !important;
    font-weight: 800 !important;
    letter-spacing: 1.5px !important;
}

.incident-card h3 {
    color: #f8fafc !important;
    font-size: 16px !important;
    margin-top: 6px !important;
}

/* ---------- BADGES ---------- */

.incident-badges {
    display: flex !important;
    align-items: center !important;
    justify-content: flex-end !important;
    gap: 8px !important;
    flex-wrap: wrap;
}

.risk-badge,
.status-badge {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    min-width: 88px;
    padding: 6px 11px !important;
    border-radius: 999px !important;
    font-size: 10px !important;
    font-weight: 800 !important;
    letter-spacing: .7px;
}

/* Severity */

.risk-badge.critical {
    background: rgba(248,113,113,.10) !important;
    color: #fca5a5 !important;
    border: 1px solid rgba(248,113,113,.35) !important;
}

.risk-badge.high {
    background: rgba(251,146,60,.10) !important;
    color: #fdba74 !important;
    border: 1px solid rgba(251,146,60,.35) !important;
}

.risk-badge.medium {
    background: rgba(250,204,21,.10) !important;
    color: #fde047 !important;
    border: 1px solid rgba(250,204,21,.35) !important;
}

.risk-badge.low {
    background: rgba(52,211,153,.10) !important;
    color: #86efac !important;
    border: 1px solid rgba(52,211,153,.35) !important;
}

/* Status */

.status-badge.open {
    background: rgba(56,189,248,.10) !important;
    color: #7dd3fc !important;
    border: 1px solid rgba(56,189,248,.30) !important;
}

.status-badge.investigating {
    background: rgba(167,139,250,.10) !important;
    color: #c4b5fd !important;
    border: 1px solid rgba(167,139,250,.30) !important;
}

.status-badge.contained {
    background: rgba(52,211,153,.10) !important;
    color: #6ee7b7 !important;
    border: 1px solid rgba(52,211,153,.30) !important;
}

.status-badge.closed {
    background: rgba(100,116,139,.12) !important;
    color: #cbd5e1 !important;
    border: 1px solid rgba(100,116,139,.30) !important;
}

/* ---------- INCIDENT INFORMATION ---------- */

.incident-main {
    padding-top: 18px !important;
}

.info-item {
    background: rgba(15,23,42,.55);
    border: 1px solid rgba(148,163,184,.08);
    border-radius: 10px;
    padding: 11px 13px;
    margin-bottom: 9px;
}

.info-label {
    color: #64748b !important;
    font-size: 10px !important;
    font-weight: 800 !important;
    letter-spacing: .8px;
}

.info-value {
    color: #dbeafe !important;
    font-weight: 600;
}

/* ---------- SCANNER ---------- */

input[type="file"] {
    background: #0b1728 !important;
    border: 1px dashed #334e68 !important;
    border-radius: 12px !important;
    padding: 14px !important;
    color: #cbd5e1 !important;
}

button {
    border-radius: 9px;
    transition: transform .15s ease, opacity .15s ease;
}

button:hover {
    transform: translateY(-1px);
}

#scanButton {
    background: linear-gradient(135deg, #0284c7, #2563eb) !important;
    border: none !important;
    box-shadow: 0 8px 20px rgba(37,99,235,.18);
}

/* ---------- DETAILS MODAL ---------- */

#detailsModal {
    backdrop-filter: blur(8px);
}

#detailsModal .modal-content {
    border-radius: 18px !important;
    border: 1px solid #29415c !important;
}

/* ---------- SUCCESS / ERROR / INFO ---------- */

.success {
    color: #6ee7b7 !important;
}

.error {
    color: #fca5a5 !important;
}

.info {
    color: #7dd3fc !important;
}

/* ---------- RESPONSIVE ---------- */

@media (max-width: 800px) {

    .incident-card-header {
        flex-direction: column !important;
    }

    .incident-badges {
        justify-content: flex-start !important;
    }

    .incident-meta {
        grid-template-columns: 1fr !important;
    }

    .stat-number {
        font-size: 24px !important;
    }
}



        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #0f172a;
            color: white;
        }

        header {
            background: #111827;
            padding: 20px 30px;
            border-bottom: 1px solid #374151;
        }

        header h1 {
            margin: 0;
        }

        header p {
            color: #94a3b8;
        }

        .container {
            padding: 25px;
            max-width: 1200px;
            margin: auto;
        }

        .scanner {
            background: #1e293b;
            padding: 25px;
            border-radius: 12px;
            margin-bottom: 25px;
        }

        .scanner h2 {
            margin-top: 0;
        }

        input[type="file"] {
            margin: 15px 0;
            padding: 10px;
            background: #334155;
            color: white;
            border-radius: 6px;
            width: 100%;
        }

        button {
            background: #2563eb;
            color: white;
            border: none;
            padding: 10px 16px;
            border-radius: 7px;
            cursor: pointer;
            font-weight: bold;
            margin: 4px;
        }

        button:hover {
            opacity: 0.9;
        }

        button:disabled {
            background: #475569;
            cursor: not-allowed;
        }

        .details-btn {
            background: #7c3aed;
        }

        .quarantine {
            color: #ef4444;
            font-weight: bold;
        }

        #selectedFiles {
            color: #cbd5e1;
            margin: 10px 0;
        }

        .result {
            background: #1e293b;
            padding: 20px;
            border-radius: 12px;
            margin-top: 15px;
            border-left: 4px solid #334155;
        }

        .result h3 {
            margin-top: 0;
        }

        .LOW {
            color: #22c55e;
            font-weight: bold;
        }

        .MEDIUM {
            color: #eab308;
            font-weight: bold;
        }

        .HIGH {
            color: #fb923c;
            font-weight: bold;
        }

        .CRITICAL {
            color: #ef4444;
            font-weight: bold;
        }

        .hash {
            font-family: monospace;
            font-size: 12px;
            word-break: break-all;
            background: #0f172a;
            padding: 10px;
            border-radius: 6px;
        }

        .reason {
            margin: 6px 0;
            color: #fbbf24;
        }

        .success {
            color: #22c55e;
        }

        .error {
            color: #ef4444;
        }

        .info {
            color: #38bdf8;
        }

        .incident {
            color: #cbd5e1;
            font-family: monospace;
            font-size: 13px;
        }

        footer {
            text-align: center;
            padding: 25px;
            color: #64748b;
        }

        /* MODAL */

        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.75);
            overflow: auto;
        }

        .modal-content {
            background: #1e293b;
            margin: 5% auto;
            padding: 25px;
            width: 90%;
            max-width: 800px;
            border-radius: 12px;
            border: 1px solid #475569;
        }

        .close {
            float: right;
            font-size: 28px;
            cursor: pointer;
            color: #94a3b8;
        }

        .close:hover {
            color: white;
        }

        .detail-row {
            padding: 10px 0;
            border-bottom: 1px solid #374151;
        }

        .detail-label {
            color: #94a3b8;
            font-weight: bold;
        }

        .history {
            background: #0f172a;
            padding: 12px;
            border-radius: 8px;
            margin-top: 10px;
        }

        @media (max-width: 700px) {

            .container {
                padding: 15px;
            }

            .modal-content {
                width: 95%;
                margin: 10% auto;
            }

        }

    
<style>

/* ==========================================
   PROFESSIONAL INCIDENT CARDS
========================================== */

.incident-card {
    background: linear-gradient(
        145deg,
        #111827,
        #0f172a
    );

    border: 1px solid #374151;
    border-radius: 16px;

    margin: 18px 0;
    padding: 20px;

    box-shadow:
        0 8px 24px rgba(0,0,0,.30);

    transition:
        transform .2s ease,
        box-shadow .2s ease,
        border-color .2s ease;
}

.incident-card:hover {
    transform: translateY(-2px);

    border-color: #4b5563;

    box-shadow:
        0 12px 30px rgba(0,0,0,.40);
}


.incident-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;

    gap: 15px;

    padding-bottom: 15px;

    border-bottom: 1px solid #374151;
}


.incident-label {
    font-size: 10px;
    font-weight: bold;

    letter-spacing: 1.5px;

    color: #9ca3af;

    margin-bottom: 5px;
}


.incident-card h3 {
    margin: 0;

    color: #f9fafb;

    font-size: 17px;
}


.incident-badges {
    display: flex;
    gap: 8px;

    flex-wrap: wrap;
}


.risk-badge,
.status-badge {
    padding: 6px 11px;

    border-radius: 999px;

    font-size: 11px;

    font-weight: bold;

    letter-spacing: .5px;
}


/* Risk */

.risk-badge.critical {
    background: rgba(239,68,68,.15);
    color: #ef4444;
    border: 1px solid #ef4444;
}

.risk-badge.high {
    background: rgba(249,115,22,.15);
    color: #f97316;
    border: 1px solid #f97316;
}

.risk-badge.medium {
    background: rgba(234,179,8,.15);
    color: #eab308;
    border: 1px solid #eab308;
}

.risk-badge.low {
    background: rgba(34,197,94,.15);
    color: #22c55e;
    border: 1px solid #22c55e;
}


/* Status */

.status-badge.open {
    background: rgba(59,130,246,.15);
    color: #60a5fa;
    border: 1px solid #3b82f6;
}

.status-badge.contained {
    background: rgba(168,85,247,.15);
    color: #c084fc;
    border: 1px solid #a855f7;
}


/* Main */

.incident-main {
    padding: 18px 0;
}


.incident-info {
    display: grid;

    grid-template-columns:
        repeat(
            auto-fit,
            minmax(180px, 1fr)
        );

    gap: 12px;
}


.info-item {
    background: #0b1220;

    border: 1px solid #1f2937;

    border-radius: 10px;

    padding: 12px;
}


.info-label {
    display: block;

    color: #9ca3af;

    font-size: 10px;

    font-weight: bold;

    letter-spacing: 1px;

    margin-bottom: 6px;
}


.info-value {
    display: block;

    color: #e5e7eb;

    font-size: 13px;

    word-break: break-word;
}


.info-value.score {
    font-size: 20px;

    font-weight: bold;

    color: #f9fafb;
}


.incident-reasons {
    margin-top: 15px;

    background: #0b1220;

    border: 1px solid #1f2937;

    border-radius: 10px;

    padding: 14px;
}


.incident-reasons ul {
    margin: 8px 0 0 18px;

    color: #d1d5db;

    font-size: 13px;
}


.incident-reasons li {
    margin: 5px 0;
}


/* Footer */

.incident-footer {
    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 12px;

    padding-top: 15px;

    border-top: 1px solid #374151;
}


.incident-time {
    color: #9ca3af;

    font-size: 11px;

    word-break: break-all;
}


.details-button {
    background: #2563eb;

    color: white;

    border: none;

    padding: 9px 15px;

    border-radius: 8px;

    cursor: pointer;

    font-weight: bold;

    font-size: 12px;

    transition: .2s;
}


.details-button:hover {
    background: #1d4ed8;

    transform: translateY(-1px);
}


@media (max-width: 700px) {

    .incident-card-header {
        flex-direction: column;
    }

    .incident-footer {
        flex-direction: column;

        align-items: stretch;
    }

    .details-button {
        width: 100%;
    }

}



/* =========================================================
   RDRS PROFESSIONAL SIDEBAR
========================================================= */

body {
    padding-left: 250px !important;
    background:
        radial-gradient(
            circle at 80% 0%,
            rgba(37, 99, 235, 0.10),
            transparent 35%
        ),
        #020617 !important;
}

header {
    margin-left: -250px !important;
    padding-left: 280px !important;
    background: rgba(15, 23, 42, 0.94) !important;
    backdrop-filter: blur(12px);
    position: sticky;
    top: 0;
    z-index: 900;
}

.rdrs-sidebar {
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    width: 250px;
    z-index: 2000;
    background: #020617;
    border-right: 1px solid #1e293b;
    display: flex;
    flex-direction: column;
    box-shadow: 10px 0 35px rgba(0,0,0,0.25);
}

.rdrs-brand {
    height: 82px;
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    border-bottom: 1px solid #1e293b;
}

.rdrs-brand-icon {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    font-size: 21px;
    box-shadow: 0 8px 25px rgba(37,99,235,.25);
}

.rdrs-brand-text strong {
    display: block;
    color: white;
    font-size: 18px;
    letter-spacing: .5px;
}

.rdrs-brand-text span {
    color: #64748b;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1.2px;
}

.rdrs-nav {
    padding: 22px 12px;
    flex: 1;
}

.rdrs-nav-title {
    color: #475569;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 1.5px;
    padding: 0 12px 10px;
    text-transform: uppercase;
}

.rdrs-nav a {
    display: flex;
    align-items: center;
    gap: 13px;
    text-decoration: none;
    color: #94a3b8;
    padding: 12px 14px;
    margin: 4px 0;
    border-radius: 9px;
    font-size: 14px;
    transition: .2s ease;
}

.rdrs-nav a:hover {
    background: #0f172a;
    color: white;
    transform: translateX(2px);
}

.rdrs-nav a.active {
    background: linear-gradient(
        90deg,
        rgba(37,99,235,.20),
        rgba(37,99,235,.06)
    );
    color: #60a5fa;
    border-left: 3px solid #3b82f6;
}

.rdrs-nav-icon {
    width: 22px;
    text-align: center;
    font-size: 17px;
}

.rdrs-system {
    margin: 12px;
    padding: 15px;
    border-radius: 12px;
    background: #0f172a;
    border: 1px solid #1e293b;
}

.rdrs-system-title {
    color: #64748b;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 9px;
}

.rdrs-online {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #22c55e;
    font-size: 12px;
    font-weight: bold;
}

.rdrs-online-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 10px #22c55e;
}

.rdrs-user {
    padding: 15px;
    border-top: 1px solid #1e293b;
    display: flex;
    align-items: center;
    gap: 10px;
}

.rdrs-avatar {
    width: 35px;
    height: 35px;
    border-radius: 50%;
    background: #1e40af;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
}

.rdrs-user-info {
    flex: 1;
}

.rdrs-user-info strong {
    display: block;
    font-size: 13px;
    color: white;
}

.rdrs-user-info span {
    display: block;
    color: #64748b;
    font-size: 10px;
}

.rdrs-logout {
    border: none !important;
    background: transparent !important;
    color: #64748b !important;
    padding: 7px !important;
    margin: 0 !important;
    width: auto !important;
}

.rdrs-logout:hover {
    color: #ef4444 !important;
    background: #1f2937 !important;
}

.rdrs-pagebar {
    margin: 25px auto 0;
    max-width: 1200px;
    padding: 0 25px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.rdrs-page-title h2 {
    margin: 0;
    font-size: 24px;
    color: #f8fafc;
}

.rdrs-page-title p {
    margin: 5px 0 0;
    color: #64748b;
    font-size: 13px;
}

.rdrs-live {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 13px;
    border-radius: 20px;
    background: rgba(34,197,94,.08);
    border: 1px solid rgba(34,197,94,.2);
    color: #22c55e;
    font-size: 11px;
    font-weight: bold;
}

.rdrs-live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 9px #22c55e;
}

@media (max-width: 850px) {

    body {
        padding-left: 0 !important;
    }

    .rdrs-sidebar {
        width: 70px;
    }

    .rdrs-brand {
        justify-content: center;
        padding: 15px;
    }

    .rdrs-brand-text,
    .rdrs-nav-title,
    .rdrs-nav a span,
    .rdrs-system,
    .rdrs-user-info,
    .rdrs-logout {
        display: none !important;
    }

    .rdrs-nav a {
        justify-content: center;
        padding: 13px;
    }

    header {
        margin-left: 0 !important;
        padding-left: 20px !important;
    }
}


</style>

</style>


<style>
.soc-incidents {
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin-top: 20px;
}

.soc-card {
    background: #111827;
    border: 1px solid #374151;
    border-left: 6px solid #6b7280;
    border-radius: 12px;
    padding: 18px;
    box-shadow: 0 5px 15px rgba(0,0,0,.25);
}

.soc-card.critical { border-left-color: #ef4444; }
.soc-card.high { border-left-color: #f97316; }
.soc-card.medium { border-left-color: #eab308; }
.soc-card.low { border-left-color: #22c55e; }

.soc-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
}

.soc-id {
    font-weight: bold;
    font-size: 16px;
}

.soc-level {
    padding: 5px 10px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: bold;
}

.soc-level.critical {
    background: #7f1d1d;
    color: #fecaca;
}

.soc-level.high {
    background: #7c2d12;
    color: #fed7aa;
}

.soc-level.medium {
    background: #713f12;
    color: #fef08a;
}

.soc-level.low {
    background: #14532d;
    color: #bbf7d0;
}

.soc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit,minmax(180px,1fr));
    gap: 10px;
    margin-top: 15px;
}

.soc-item {
    background: #0b1220;
    padding: 10px;
    border-radius: 8px;
}

.soc-label {
    color: #9ca3af;
    font-size: 11px;
    text-transform: uppercase;
}

.soc-value {
    margin-top: 4px;
    font-weight: 600;
    word-break: break-word;
}

.soc-reasons {
    margin-top: 15px;
    padding: 12px;
    background: #0b1220;
    border-radius: 8px;
}

.soc-reasons ul {
    margin: 8px 0 0 20px;
}

.soc-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 15px;
}

.soc-btn {
    border: 0;
    border-radius: 7px;
    padding: 8px 12px;
    cursor: pointer;
    font-weight: bold;
    color: white;
}

.btn-open { background: #2563eb; }
.btn-investigating { background: #ca8a04; }
.btn-contained { background: #7c3aed; }
.btn-closed { background: #15803d; }

.soc-btn:hover {
    opacity: .8;
}

.soc-empty {
    padding: 25px;
    text-align: center;
    color: #9ca3af;
}
</style>


<style>
/* ==========================================
   PROFESSIONAL INCIDENT CARDS
========================================== */

.incident-card {
    background: linear-gradient(145deg, #111827, #0f172a);
    border: 1px solid #374151;
    border-radius: 14px;
    padding: 20px;
    margin: 15px 0;
    box-shadow: 0 8px 24px rgba(0,0,0,.25);
    transition: all .2s ease;
}

.incident-card:hover {
    transform: translateY(-2px);
    border-color: #60a5fa;
    box-shadow: 0 12px 30px rgba(0,0,0,.35);
}

.incident-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    flex-wrap: wrap;
    margin-bottom: 15px;
}

.incident-id {
    font-size: 17px;
    font-weight: 700;
    color: #f9fafb;
}

.incident-badges {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

.incident-badge {
    padding: 5px 10px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
}

.badge-critical {
    background: rgba(239,68,68,.15);
    color: #f87171;
    border: 1px solid #ef4444;
}

.badge-high {
    background: rgba(249,115,22,.15);
    color: #fb923c;
    border: 1px solid #f97316;
}

.badge-medium {
    background: rgba(234,179,8,.15);
    color: #facc15;
    border: 1px solid #eab308;
}

.badge-low {
    background: rgba(34,197,94,.15);
    color: #4ade80;
    border: 1px solid #22c55e;
}

.badge-contained {
    background: rgba(168,85,247,.15);
    color: #c084fc;
    border: 1px solid #a855f7;
}

.incident-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 12px;
    margin: 15px 0;
}

.incident-info {
    background: rgba(255,255,255,.03);
    border: 1px solid #1f2937;
    border-radius: 9px;
    padding: 11px;
}

.incident-label {
    color: #9ca3af;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .5px;
}

.incident-value {
    color: #f3f4f6;
    font-size: 14px;
    font-weight: 600;
    margin-top: 4px;
    word-break: break-word;
}

.incident-actions {
    display: flex;
    gap: 10px;
    margin-top: 15px;
}

.view-details-btn {
    background: #2563eb;
    color: white;
    border: none;
    padding: 9px 16px;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 700;
}

.view-details-btn:hover {
    background: #1d4ed8;
}

.risk-score {
    font-size: 18px;
    font-weight: 800;
}
</style>


<style>
.response-value {
    font-weight: 700;
}

.response-quarantined {
    color: #22c55e;
    font-weight: 800;
}

.response-normal {
    color: #9ca3af;
}
</style>

<style>

/* =========================================================
   RDRS-PRO-UI-V2
   Professional SOC Dashboard Layer
========================================================= */

:root {
    --rdrs-bg: #070b14;
    --rdrs-panel: #0d1422;
    --rdrs-panel2: #111a2b;
    --rdrs-border: #243149;
    --rdrs-text: #f8fafc;
    --rdrs-muted: #94a3b8;
    --rdrs-blue: #3b82f6;
    --rdrs-green: #22c55e;
    --rdrs-red: #ef4444;
    --rdrs-orange: #f97316;
}

/* Main dashboard background */

body {
    background:
        radial-gradient(
            circle at 15% 10%,
            rgba(59,130,246,.08),
            transparent 28%
        ),
        radial-gradient(
            circle at 85% 20%,
            rgba(34,197,94,.05),
            transparent 25%
        ),
        var(--rdrs-bg);
}

/* Main containers */

.scanner,
.analytics-card,
.incident-card,
.stat-card {
    backdrop-filter: blur(10px);
}

/* =========================================================
   STATISTICS CARDS
========================================================= */

.stat-card {
    position: relative;
    overflow: hidden;

    background:
        linear-gradient(
            145deg,
            #111827,
            #0b1220
        );

    border: 1px solid var(--rdrs-border);

    border-radius: 16px;

    padding: 20px;

    min-height: 105px;

    box-shadow:
        0 8px 25px rgba(0,0,0,.22);

    transition:
        transform .25s ease,
        border-color .25s ease,
        box-shadow .25s ease;
}

.stat-card::before {

    content: "";

    position: absolute;

    top: 0;
    left: 0;

    width: 100%;
    height: 3px;

    background: var(--rdrs-blue);

    opacity: .8;
}

.stat-card:hover {

    transform: translateY(-4px);

    border-color:
        rgba(96,165,250,.6);

    box-shadow:
        0 14px 35px rgba(0,0,0,.35);
}

.stat-title {

    color: var(--rdrs-muted);

    font-size: 10px;

    font-weight: 800;

    letter-spacing: 1.2px;

    text-transform: uppercase;
}

.stat-number {

    margin-top: 10px;

    color: var(--rdrs-text);

    font-size: 30px;

    font-weight: 900;

    line-height: 1;
}

/* Critical */

.stat-card.critical::before {
    background: var(--rdrs-red);
}

.stat-card.critical .stat-number {
    color: #fca5a5;
}

/* High */

.stat-card.high::before {
    background: var(--rdrs-orange);
}

.stat-card.high .stat-number {
    color: #fdba74;
}

/* Medium */

.stat-card.medium::before {
    background: #eab308;
}

.stat-card.medium .stat-number {
    color: #fde047;
}

/* Low */

.stat-card.low::before {
    background: var(--rdrs-green);
}

.stat-card.low .stat-number {
    color: #86efac;
}

/* Quarantine */

.stat-card.quarantined::before {
    background: #a855f7;
}

.stat-card.quarantined .stat-number {
    color: #d8b4fe;
}

/* =========================================================
   INCIDENT CARDS
========================================================= */

.incident-card {

    position: relative;

    background:
        linear-gradient(
            145deg,
            #111827,
            #0c1422
        );

    border: 1px solid #253149;

    border-radius: 16px;

    padding: 20px;

    margin-bottom: 15px;

    box-shadow:
        0 8px 25px rgba(0,0,0,.25);

    transition:
        transform .2s ease,
        box-shadow .2s ease,
        border-color .2s ease;
}

.incident-card:hover {

    transform: translateY(-3px);

    border-color: #3b82f6;

    box-shadow:
        0 15px 35px rgba(0,0,0,.35);
}

/* Incident header */

.incident-card-header {

    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 15px;

    padding-bottom: 15px;

    border-bottom: 1px solid #1e293b;
}

.incident-label {

    color: #64748b;

    font-size: 9px;

    font-weight: 800;

    letter-spacing: 1.5px;
}

.incident-card h3 {

    margin-top: 5px;

    color: #f8fafc;

    font-size: 15px;

    font-weight: 800;
}

/* =========================================================
   BADGES
========================================================= */

.risk-badge,
.status-badge {

    display: inline-flex;

    justify-content: center;

    align-items: center;

    min-width: 85px;

    padding: 7px 12px;

    border-radius: 999px;

    font-size: 10px;

    font-weight: 900;

    letter-spacing: .7px;

    text-transform: uppercase;
}

.risk-badge.critical {

    background: rgba(239,68,68,.12);

    color: #fca5a5;

    border: 1px solid #ef4444;

    box-shadow:
        0 0 15px rgba(239,68,68,.12);
}

.risk-badge.high {

    background: rgba(249,115,22,.12);

    color: #fdba74;

    border: 1px solid #f97316;
}

.risk-badge.medium {

    background: rgba(234,179,8,.12);

    color: #fde047;

    border: 1px solid #eab308;
}

.risk-badge.low {

    background: rgba(34,197,94,.12);

    color: #86efac;

    border: 1px solid #22c55e;
}

.status-badge.open {

    background: rgba(59,130,246,.12);

    color: #93c5fd;

    border: 1px solid #3b82f6;
}

.status-badge.investigating {

    background: rgba(168,85,247,.12);

    color: #d8b4fe;

    border: 1px solid #a855f7;
}

.status-badge.contained {

    background: rgba(16,185,129,.12);

    color: #6ee7b7;

    border: 1px solid #10b981;
}

.status-badge.closed {

    background: rgba(100,116,139,.12);

    color: #cbd5e1;

    border: 1px solid #64748b;
}

/* =========================================================
   INCIDENT INFORMATION
========================================================= */

.incident-main {

    padding-top: 18px;
}

.info-item {

    background:
        rgba(15,23,42,.55);

    border: 1px solid #1e293b;

    border-radius: 10px;

    padding: 11px;

    transition: .2s;
}

.info-item:hover {

    border-color: #334155;

    background:
        rgba(30,41,59,.65);
}

.info-label {

    color: #64748b;

    font-size: 9px;

    font-weight: 800;

    letter-spacing: 1px;
}

.info-value {

    display: block;

    margin-top: 5px;

    color: #e2e8f0;

    font-size: 12px;

    font-weight: 600;

    word-break: break-word;
}

/* =========================================================
   ANALYTICS
========================================================= */

.rdrs-analytics {

    position: relative;

    margin: 25px 0;

}

.analytics-card {

    border-color:
        #243149;

    box-shadow:
        0 10px 30px rgba(0,0,0,.28);
}

.analytics-title {

    font-size: 13px;

    letter-spacing: 1.2px;
}

.analytics-subtitle {

    color: #64748b;
}

/* =========================================================
   LIVE INDICATOR
========================================================= */

.live-dot {

    display: inline-flex;

    align-items: center;

    gap: 4px;

    color: #4ade80;

    background:
        rgba(34,197,94,.08);

    border:
        1px solid rgba(34,197,94,.2);

    box-shadow:
        0 0 12px rgba(34,197,94,.08);
}

.live-dot::first-letter {
    color: #22c55e;
}

/* =========================================================
   SCANNER
========================================================= */

#results {

    margin-top: 18px;
}

#message {

    margin-top: 12px;
}

.scanner input[type="file"] {

    background: #0f172a;

    border: 1px dashed #334155;

    border-radius: 12px;

    padding: 12px;

    color: #94a3b8;
}

/* =========================================================
   SCROLLBAR
========================================================= */

::-webkit-scrollbar {

    width: 7px;

}

::-webkit-scrollbar-track {

    background: #080c14;

}

::-webkit-scrollbar-thumb {

    background: #334155;

    border-radius: 10px;

}

::-webkit-scrollbar-thumb:hover {

    background: #475569;

}

/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 900px) {

    .incident-card-header {

        align-items: flex-start;

        flex-direction: column;
    }

    .incident-badges {

        width: 100%;
    }

}

@media (max-width: 600px) {

    .stat-number {

        font-size: 24px;
    }

    .analytics-card {

        padding: 16px;
    }

    .incident-card {

        padding: 15px;
    }

}

</style>

<style>
/* =========================================
   RDRS RISK DISTRIBUTION - FINAL FIX
========================================= */

#rdrsRiskChart {
    width: 220px !important;
    height: 220px !important;
    min-width: 220px !important;
    min-height: 220px !important;
    border-radius: 50% !important;
    position: relative !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    background: #374151 !important;
    transition: background 0.6s ease !important;
    box-sizing: border-box !important;
}

#rdrsRiskChart .donut-center {
    width: 125px !important;
    height: 125px !important;
    border-radius: 50% !important;
    background: #0b1220 !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    position: absolute !important;
    inset: 50% auto auto 50% !important;
    transform: translate(-50%, -50%) !important;
    z-index: 2 !important;
}

#riskTotalValue {
    font-size: 34px !important;
    font-weight: 800 !important;
    line-height: 1 !important;
}

#rdrsRiskChart .donut-label {
    margin-top: 8px !important;
    font-size: 11px !important;
    letter-spacing: 2px !important;
    opacity: 0.7 !important;
}
</style>

</head>


<body>

<!-- =====================================================
     RDRS PROFESSIONAL SIDEBAR
====================================================== -->

<aside class="rdrs-sidebar">

    <div class="rdrs-brand">

        <div class="rdrs-brand-icon">
            🛡️
        </div>

        <div class="rdrs-brand-text">
            <strong>RDRS</strong>
            <span>Security Platform</span>
        </div>

    </div>


    <nav class="rdrs-nav">

        <div class="rdrs-nav-title">
            Main Menu
        </div>

        <a href="/" class="active">
            <span class="rdrs-nav-icon">📊</span>
            <span>Dashboard</span>
        </a>

        <a href="#scanner">
            <span class="rdrs-nav-icon">🔍</span>
            <span>File Scanner</span>
        </a>

        <a href="#incidents">
            <span class="rdrs-nav-icon">🚨</span>
            <span>Incidents</span>
        </a>

        <a href="#statistics">
            <span class="rdrs-nav-icon">📈</span>
            <span>Statistics</span>
        </a>

        <div class="rdrs-nav-title" style="margin-top:22px;">
            System
        </div>

        <a href="/health" target="_blank">
            <span class="rdrs-nav-icon">💚</span>
            <span>System Health</span>
        </a>

        <a href="/api" target="_blank">
            <span class="rdrs-nav-icon">⚙️</span>
            <span>API</span>
        </a>

    </nav>


    <div class="rdrs-system">

        <div class="rdrs-system-title">
            System Status
        </div>

        <div class="rdrs-online">
            <span class="rdrs-online-dot"></span>
            SYSTEM ONLINE
        </div>

    </div>


    <div class="rdrs-user">

        <div class="rdrs-avatar">
            A
        </div>

        <div class="rdrs-user-info">
            <strong>Administrator</strong>
            <span>Security Analyst</span>
        </div>

        <button
            class="rdrs-logout"
            onclick="logoutRDRS()"
            title="Logout"
        >
            ⎋
        </button>

    </div>

</aside>


<!-- PROFESSIONAL PAGE HEADER -->

<div class="rdrs-pagebar">

    <div class="rdrs-page-title">

        <h2>Security Overview</h2>

        <p>
            Real-Time Ransomware Detection & Response System
        </p>

    </div>

    <div class="rdrs-live">

        <span class="rdrs-live-dot"></span>

        LIVE MONITORING

    </div>

</div>



<header>

    <h1>🛡️ RDRS Security Dashboard</h1>

    <p>
        Real-Time Ransomware Detection & Response System
    </p>

    <p class="success">
        ● SYSTEM ONLINE
    </p>

</header>


<div class="container">

    <!-- FILE SCANNER -->

    <div class="scanner" id="scanner">

        <h2>📁 RDRS File Scanner</h2>

        <p>
            Select one or multiple files from your computer
            and scan them for ransomware indicators.
        </p>

        <input
            type="file"
            id="fileInput"
            multiple
        >

        <div id="selectedFiles">
            No files selected.
        </div>

        <button
            id="scanButton"
            onclick="scanFiles()"
        >
            🔍 SCAN FILES
        </button>

        <div id="message"></div>

    </div>


    <!-- RESULTS -->

    <div id="results"></div>
<div class="scanner" >

    

<!-- ================= RDRS PROFESSIONAL ANALYTICS ================= -->

<section id="rdrs-analytics-panel" class="rdrs-analytics">

    <div class="analytics-header">
        <div>
            <div class="analytics-kicker">SECURITY ANALYTICS</div>
        </div>

        <div class="analytics-live">
            <span></span> LIVE DATA
        </div>
    </div>

    <div class="analytics-grid">

        <!-- RISK DONUT -->
        <div class="analytics-card risk-card">

            <div class="card-heading">
                <div>
                    <h3>Risk Distribution</h3>
                    <p>Incident severity breakdown</p>
                </div>

                <span class="card-icon">◉</span>
            </div>

            <div class="donut-wrapper">

                <div class="donut-chart"
                     id="rdrsRiskDonut">

                    <div class="donut-center">
                        <strong id="riskTotal">0</strong>
                        <span>INCIDENTS</span>
                    </div>

                </div>

                <div class="risk-legend">

                    <div class="legend-item">
                        <span class="legend-dot critical-dot"></span>
                        <span>Critical</span>
                        <strong id="riskCritical">0</strong>
                    </div>

                    <div class="legend-item">
                        <span class="legend-dot high-dot"></span>
                        <span>High</span>
                        <strong id="riskHigh">0</strong>
                    </div>

                    <div class="legend-item">
                        <span class="legend-dot medium-dot"></span>
                        <span>Medium</span>
                        <strong id="riskMedium">0</strong>
                    </div>

                    <div class="legend-item">
                        <span class="legend-dot low-dot"></span>
                        <span>Low</span>
                        <strong id="riskLow">0</strong>
                    </div>

                </div>

            </div>

        </div>


        <!-- RESPONSE STATUS -->

        <div class="analytics-card status-card">

            <div class="card-heading">

                <div>
                    <h3>Incident Lifecycle</h3>
                    <p>Current response status</p>
                </div>

                <span class="card-icon">◈</span>

            </div>

            <div class="status-list">

                <div class="status-row">
                    <div class="status-name">
                        <span class="status-indicator open-indicator"></span>
                        OPEN
                    </div>

                    <strong id="analyticsOpen">0</strong>
                </div>

                <div class="status-progress">
                    <div id="analyticsOpenBar"></div>
                </div>


                <div class="status-row">
                    <div class="status-name">
                        <span class="status-indicator investigating-indicator"></span>
                        INVESTIGATING
                    </div>

                    <strong id="analyticsInvestigating">0</strong>
                </div>

                <div class="status-progress">
                    <div id="analyticsInvestigatingBar"></div>
                </div>


                <div class="status-row">
                    <div class="status-name">
                        <span class="status-indicator contained-indicator"></span>
                        CONTAINED
                    </div>

                    <strong id="analyticsContained">0</strong>
                </div>

                <div class="status-progress">
                    <div id="analyticsContainedBar"></div>
                </div>


                <div class="status-row">
                    <div class="status-name">
                        <span class="status-indicator closed-indicator"></span>
                        CLOSED
                    </div>

                    <strong id="analyticsClosed">0</strong>
                </div>

                <div class="status-progress">
                    <div id="analyticsClosedBar"></div>
                </div>

            </div>

        </div>

    </div>

</section>

<style>

.rdrs-analytics {
    margin: 28px 0;
}

.analytics-header {
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    margin-bottom:18px;
    gap:20px;
}

.analytics-kicker {
    color:#60a5fa;
    font-size:11px;
    font-weight:800;
    letter-spacing:1.8px;
}

.analytics-header h2 {
    margin:5px 0;
    color:#f8fafc;
    font-size:22px;
}

.analytics-header p {
    margin:0;
    color:#94a3b8;
    font-size:13px;
}

.analytics-live {
    display:flex;
    align-items:center;
    gap:8px;
    padding:7px 12px;
    border:1px solid #14532d;
    border-radius:20px;
    background:#052e16;
    color:#86efac;
    font-size:10px;
    font-weight:800;
}

.analytics-live span {
    width:7px;
    height:7px;
    border-radius:50%;
    background:#22c55e;
    box-shadow:0 0 10px #22c55e;
}

.analytics-grid {
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:18px;
}

.analytics-card {
    background:linear-gradient(145deg,#111827,#0b1220);
    border:1px solid #263244;
    border-radius:16px;
    padding:20px;
    box-shadow:0 10px 30px rgba(0,0,0,.22);
}

.analytics-card:hover {
    border-color:#3b82f6;
}

.card-heading {
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
}

.card-heading h3 {
    margin:0;
    color:#f8fafc;
    font-size:15px;
}

.card-heading p {
    margin:5px 0 0;
    color:#64748b;
    font-size:11px;
}

.card-icon {
    color:#60a5fa;
    font-size:24px;
}

.donut-wrapper {
    display:flex;
    align-items:center;
    justify-content:center;
    gap:35px;
    min-height:230px;
}

.donut-chart {
    width:175px;
    height:175px;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    position:relative;
    background:
        conic-gradient(
            #334155 0deg 360deg
        );
}

.donut-chart::before {
    content:"";
    position:absolute;
    width:116px;
    height:116px;
    background:#0f172a;
    border-radius:50%;
}

.donut-center {
    position:relative;
    z-index:2;
